      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Er will in dieser Saison unbedingt in die Silberliga aufsteigen. Aber das geht natürlich nur, wenn er bessere Mitspieler erwischt als bisher."
          },
          "enUS": {
            "present": true,
            "value": "\"You have my shield! And the rest of me too.\""
          },
          "esES": {
            "present": true,
            "value": "«¡Cuenta con mi escudo!»."
          },
          "esMX": {
            "present": true,
            "value": "\"¡Tienes mi escudo! Y también el resto de mí\"."
          },
          "frFR": {
            "present": true,
            "value": "« Mon bouclier est vôtre ! »"
          },
          "itIT": {
            "present": true,
            "value": "\"Hai il mio scudo! E anche tutto il resto.\""
          },
          "jaJP": {
            "present": true,
            "value": "彼は密かに自分を「キャプテン・ネザーストーム」と呼んでいる。"
          },
          "koKR": {
            "present": true,
            "value": "\"제 방패는 당신 것입니다! 나머지 부품도 당신 것이고요.\""
          },
          "plPL": {
            "present": true,
            "value": "„Masz moją tarczę! I całą resztę w sumie też”."
          },
          "ptBR": {
            "present": true,
            "value": "\"Meu escudo está com você! E o resto também.\""
          },
          "ruRU": {
            "present": true,
            "value": "«Мой щит тебя защитит!»"
          },
          "thTH": {
            "present": true,
            "value": "\"โล่ข้าเป็นของเจ้า! ส่วนอื่นๆ ในตัวข้าก็เหมือนกัน\""
          },
          "zhCN": {
            "present": true,
            "value": "我的盾，我的全身心，现在都属于你。"
          },
          "zhTW": {
            "present": true,
            "value": "「我的盾，跟我的人都是你的。」"
          }
        },
        "textContent": "\n\t\t\tEr will in dieser Saison unbedingt in die Silberliga aufsteigen. Aber das geht natürlich nur, wenn er bessere Mitspieler erwischt als bisher.\n\t\t\t\"You have my shield! And the rest of me too.\"\n\t\t\t«¡Cuenta con mi escudo!».\n\t\t\t\"¡Tienes mi escudo! Y también el resto de mí\".\n\t\t\t« Mon bouclier est vôtre ! »\n\t\t\t\"Hai il mio scudo! E anche tutto il resto.\"\n\t\t\t彼は密かに自分を「キャプテン・ネザーストーム」と呼んでいる。\n\t\t\t\"제 방패는 당신 것입니다! 나머지 부품도 당신 것이고요.\"\n\t\t\t„Masz moją tarczę! I całą resztę w sumie też”.\n\t\t\t\"Meu escudo está com você! E o resto também.\"\n\t\t\t«Мой щит тебя защитит!»\n\t\t\t\"โล่ข้าเป็นของเจ้า! ส่วนอื่นๆ ในตัวข้าก็เหมือนกัน\"\n\t\t\t我的盾，我的全身心，现在都属于你。\n\t\t\t「我的盾，跟我的人都是你的。」\n\t\t"
      },
