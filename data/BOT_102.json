    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Spark Drill"
          },
          "koKR": {
            "present": true,
            "value": "불꽃 드릴"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tFunkenbohrer\n\t\t\tSpark Drill\n\t\t\tTaladro de chispas\n\t\t\tTaladro de chispas\n\t\t\tFore-étincelles\n\t\t\tTrivella a Scintilla\n\t\t\tスパーク・ドリル\n\t\t\t불꽃 드릴\n\t\t\tIskrzące wiertło\n\t\t\tPerfuratriz Faiscante\n\t\t\tЭлектробур\n\t\t\tสว่านประกายไฟ\n\t\t\t火花钻机\n\t\t\t火花鑽孔機\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Rush</b>\n<b>Deathrattle:</b> Add two\n1/1 Sparks with <b>Rush</b> to your hand."
          },
          "koKR": {
            "present": true,
            "value": "[x]<b>속공</b>, <b>죽음의 메아리:</b>\n<b>속공</b> 능력이 있는 1/1\n불꽃 둘을 내 손으로\n가져옵니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Eifer</b>. <b>Todesröcheln:</b> Erhaltet 2 Funken (1/1) mit <b>Eifer</b> auf die Hand.\n\t\t\t<b>Rush</b>\n<b>Deathrattle:</b> Add two\n1/1 Sparks with <b>Rush</b> to your hand.\n\t\t\t[x]<b>Embestir</b>\n<b>Último aliento:</b> Añade dos\nchispas 1/1 con <b>Embestir</b>\na tu mano.\n\t\t\t<b>Acometida</b>\n<b>Estertor:</b> agrega dos Chispas 1/1 con <b>Acometida</b> a tu mano.\n\t\t\t<b>Ruée</b>\n<b>Râle d’agonie_:</b> ajoute deux étincelles_1/1 avec <b>Ruée</b> dans votre main.\n\t\t\t[x]<b>Assalto</b>. <b>Rantolo di Morte:</b>\nmette nella tua mano\ndue Scintille 1/1\ncon <b>Assalto</b>.\n\t\t\t[x]<b>急襲</b>\n<b>断末魔:</b>\n<b>急襲</b>を持つ1/1の\n「スパーク」2体を自分の\n手札に追加する。\n\t\t\t[x]<b>속공</b>, <b>죽음의 메아리:</b>\n<b>속공</b> 능력이 있는 1/1\n불꽃 둘을 내 손으로\n가져옵니다.\n\t\t\t<b>Zryw</b>\n<b>Agonia:</b> Dodaj dwie Iskry_1/1 ze <b>Zrywem</b> do_twojej_ręki.\n\t\t\t<b>Rapidez</b>\n<b>Último Suspiro:</b> Adicione duas Faíscas 1/1 com <b>Rapidez</b> à sua mão.\n\t\t\t<b>Натиск</b>\n<b>Предсмертный хрип:</b>\nвы кладете в руку две искры 1/1 с_<b>«Натиском»</b>.\n\t\t\t<b>จู่โจม</b>, <b>เสียงสุดท้าย:</b> เพิ่ม ประกายไฟ_1/1_ที่มี_<b>จู่โจม</b> สองใบในมือคุณ\n\t\t\t<b>突袭，亡语：</b>将两张1/1并具有<b>突袭</b>的“火花”置入你的手牌。\n\t\t\t[x]<b>衝刺</b>\n<b>死亡之聲：</b>放兩個\n有<b>衝刺</b>的1/1火花\n到你的手中\n\t\t"
      }
    },
