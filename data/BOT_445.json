          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\tBeutelmech\n\t\tMecharoo\n\t\tMeca-Nguro\n\t\tMecanguro\n\t\tKangou-bot\n\t\tCangurobot\n\t\tメカンガルー\n\t\t캥거루로봇\n\t\tKangurobot\n\t\tMecanguru\n\t\tМехуру\n\t\tเมคารู\n\t\t机械袋鼠\n\t\t機械袋鼠\n\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Deathrattle:</b> Summon a 1/1 Jo-E Bot."
          },
          "koKR": {
