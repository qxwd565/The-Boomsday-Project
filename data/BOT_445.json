            "value": "Mecharoo"
          },
          "koKR": {
            "present": true,
            "value": "캥거루로봇"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tBeutelmech\n\t\t\tMecharoo\n\t\t\tMeca-Nguro\n\t\t\tMecanguro\n\t\t\tKangou-bot\n\t\t\tCangurobot\n\t\t\tメカンガルー\n\t\t\t캥거루로봇\n\t\t\tKangurobot\n\t\t\tMecanguru\n\t\t\tМехуру\n\t\t\tเมคารู\n\t\t\t机械袋鼠\n\t\t\t機械袋鼠\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Deathrattle:</b> Summon a 1/1 Jo-E Bot."
          },
          "koKR": {
            "present": true,
            "value": "<b>죽음의 메아리:</b>\n1/1 새끼 캥거루로봇을 하나 소환합니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Todesröcheln:</b> Ruft ein Beutelmechjunges (1/1) herbei.\n\t\t\t<b>Deathrattle:</b> Summon a 1/1 Jo-E Bot.\n\t\t\t<b>Último aliento:</b> Invoca un R1t0 1/1.\n\t\t\t<b>Estertor:</b> invoca un Canguribot 1/1.\n\t\t\t<b>Râle d’agonie_:</b> invoque un petit kangou-bot_1/1.\n\t\t\t[x]<b>Rantolo di Morte:</b>\nevoca un Cucciolobot 1/1.\n\t\t\t[x]<b>断末魔:</b>\n1/1の\n「コメカンガルー」を\n1体召喚する。\n\t\t\t<b>죽음의 메아리:</b>\n1/1 새끼 캥거루로봇을 하나 소환합니다.\n\t\t\t<b>Agonia:</b> Przyzwij Kangurobocika 1/1.\n\t\t\t<b>Último Suspiro:</b> Evoque um Mecanguri 1/1.\n\t\t\t<b>Предсмертный хрип:</b> призывает мехуренка_1/1.\n\t\t\t<b>เสียงสุดท้าย:</b> เรียก โจ-อีบอท 1/1\n\t\t\t<b>亡语：</b>召唤一个1/1的机械袋鼠宝宝。\n\t\t\t<b>死亡之聲：</b>召喚一個\n1/1機械小袋鼠\n\t\t"
      }
    },
    "currentStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Mecharoo"
          },
          "koKR": {
