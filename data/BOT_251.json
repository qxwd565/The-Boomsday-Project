    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Spider Bomb"
          },
          "koKR": {
            "present": true,
            "value": "거미 폭탄"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tSpinnenbombe\n\t\t\tSpider Bomb\n\t\t\tBomba araña\n\t\t\tBomba araña\n\t\t\tBombe-araignée\n\t\t\tBombaragno\n\t\t\tクモ爆弾\n\t\t\t거미 폭탄\n\t\t\tPajęcza bomba\n\t\t\tAranha-Bomba\n\t\t\tБомба-паук\n\t\t\tระเบิดแมงมุม\n\t\t\t蜘蛛炸弹\n\t\t\t蜘蛛炸彈\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Magnetic</b>\n<b>Deathrattle:</b> Destroy a random_enemy_minion."
          },
          "koKR": {
            "present": true,
            "value": "<b>합체</b>, <b>죽음의 메아리:</b> 무작위 적 하수인\n하나를 처치합니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Magnetisch</b>. <b>Todesröcheln:</b> Vernichtet einen zufälligen feindlichen Diener.\n\t\t\t<b>Magnetic</b>\n<b>Deathrattle:</b> Destroy a random_enemy_minion.\n\t\t\t[x]<b>Magnetismo</b>\n<b>Último aliento:</b> Destruye\na un esbirro enemigo\naleatorio.\n\t\t\t<b>Magnetismo</b>\n<b>Estertor:</b> destruye un esbirro enemigo aleatorio.\n\t\t\t<b>Magnétisme</b>\n<b>Râle d’agonie_:</b> détruit un serviteur adverse aléatoire.\n\t\t\t[x]<b>Magnetismo</b>.\n<b>Rantolo di Morte:</b>\ndistrugge un servitore\nnemico casuale.\n\t\t\t[x]<b>超電磁</b>\n<b>断末魔:</b>\nランダムな\n敵のミニオン1体を\n__破壊する。\n\t\t\t<b>합체</b>, <b>죽음의 메아리:</b> 무작위 적 하수인\n하나를 처치합니다.\n\t\t\t<b>Magnetyzm</b>\n<b>Agonia:</b> Zniszcz losowego wrogiego stronnika.\n\t\t\t<b>Magnético</b>\n<b>Último Suspiro:</b> Destrua\num lacaio inimigo aleatório.\n\t\t\t[x]<b>Магнетизм</b>\n<b>Предсмертный хрип:</b>\nуничтожает случайное\n__существо противника.\n\t\t\t<b>แม่เหล็ก</b>\n<b>เสียงสุดท้าย:</b> สุ่มทำลาย[b]มินเนี่ยนศัตรูหนึ่งตัว\n\t\t\t<b>磁力，亡语：</b>随机消灭一个敌方随从。\n\t\t\t<b>合體</b>\n<b>死亡之聲：</b>摧毀一個隨機敵方手下\n\t\t"
      }
    },
