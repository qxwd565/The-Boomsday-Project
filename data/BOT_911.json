      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Es fragt Euch alle zehn Sekunden, ob Ihr ein Update installieren wollt."
          },
          "enUS": {
            "present": true,
            "value": "Every ten seconds it asks if you want to update."
          },
          "esES": {
            "present": true,
            "value": "Cada diez segundos te pregunta si quieres actualizar el sistema."
          },
          "esMX": {
            "present": true,
            "value": "Solicita permiso para instalar actualizaciones cada diez segundos."
          },
          "frFR": {
            "present": true,
            "value": "Toutes les dix secondes, il vous demande si vous voulez faire la mise à jour."
          },
          "itIT": {
            "present": true,
            "value": "Ogni dieci secondi, ti chiede se vuoi installare gli aggiornamenti."
          },
          "jaJP": {
            "present": true,
            "value": "10秒ごとに、アップデートするかどうか聞いてくるぞ。"
          },
          "koKR": {
            "present": true,
            "value": "업데이트를 할 거냐고 10초마다 물어봅니다."
          },
          "plPL": {
            "present": true,
            "value": "Co dziesięć sekund pyta, czy chcesz pobrać aktualizację."
          },
          "ptBR": {
            "present": true,
            "value": "Pede para atualizar a cada dez segundos."
          },
          "ruRU": {
            "present": true,
            "value": "Каждые десять секунд просит обновить программное обеспечение."
          },
          "thTH": {
            "present": true,
            "value": "มันจะขอให้คุณอัพเดต[b]ทุกสิบวินาที"
          },
          "zhCN": {
            "present": true,
            "value": "每隔十秒就会弹出一次，问你要不要更新。"
          },
          "zhTW": {
            "present": true,
            "value": "每十秒鐘，他就會問你一次要不要更新。"
          }
        },
        "textContent": "\n\t\t\tEs fragt Euch alle zehn Sekunden, ob Ihr ein Update installieren wollt.\n\t\t\tEvery ten seconds it asks if you want to update.\n\t\t\tCada diez segundos te pregunta si quieres actualizar el sistema.\n\t\t\tSolicita permiso para instalar actualizaciones cada diez segundos.\n\t\t\tToutes les dix secondes, il vous demande si vous voulez faire la mise à jour.\n\t\t\tOgni dieci secondi, ti chiede se vuoi installare gli aggiornamenti.\n\t\t\t10秒ごとに、アップデートするかどうか聞いてくるぞ。\n\t\t\t업데이트를 할 거냐고 10초마다 물어봅니다.\n\t\t\tCo dziesięć sekund pyta, czy chcesz pobrać aktualizację.\n\t\t\tPede para atualizar a cada dez segundos.\n\t\t\tКаждые десять секунд просит обновить программное обеспечение.\n\t\t\tมันจะขอให้คุณอัพเดต[b]ทุกสิบวินาที\n\t\t\t每隔十秒就会弹出一次，问你要不要更新。\n\t\t\t每十秒鐘，他就會問你一次要不要更新。\n\t\t"
      },
