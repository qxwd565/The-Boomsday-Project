    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Whirliglider"
          },
          "koKR": {
            "present": true,
            "value": "빙글라이더"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tWirbelgleiter\n\t\t\tWhirliglider\n\t\t\tParapentista rotatoria\n\t\t\tParapentista goblin\n\t\t\tHéliplaneuse\n\t\t\tPlanaturbini\n\t\t\tグルグルグライダー\n\t\t\t빙글라이더\n\t\t\tWirolotniczka\n\t\t\tPlanadora Rotativa\n\t\t\tВертоглайдер\n\t\t\tเวอร์ลิไกลเดอร์\n\t\t\t旋翼滑翔者\n\t\t\t旋翼滑翔者\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Summon a 0/2_Goblin Bomb."
          },
          "koKR": {
            "present": true,
            "value": "[x]<b>전투의 함성:</b>\n0/2 고블린 폭탄을\n하나 소환합니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Kampfschrei:</b> Ruft eine Goblinbombe (0/2) herbei.\n\t\t\t<b>Battlecry:</b> Summon a 0/2_Goblin Bomb.\n\t\t\t<b>Grito de batalla:</b>\nInvoca una bomba\ngoblin_0/2.\n\t\t\t<b>Grito de batalla:</b> invoca una Bomba goblin 0/2.\n\t\t\t<b>Cri de guerre_:</b>\ninvoque une bombe gobeline_0/2.\n\t\t\t<b>Grido di Battaglia:</b> evoca una Bomba Goblin 0/2.\n\t\t\t[x]<b>雄叫び:</b>\n0/2の\n「ゴブリン爆弾」を\n1体召喚する。\n\t\t\t[x]<b>전투의 함성:</b>\n0/2 고블린 폭탄을\n하나 소환합니다.\n\t\t\t<b>Okrzyk bojowy:</b> Przyzwij Goblińską bombę 0/2.\n\t\t\t<b>Grito de Guerra:</b> \nEvoque uma \nBomba Goblínica 0/2.\n\t\t\t<b>Боевой клич:</b> призывает гоблинскую бомбу 0/2.\n\t\t\t<b>คำรามสู้ศึก:</b> เรียกระเบิดก็อบลิน 0/2\n\t\t\t<b>战吼：</b>召唤一个0/2的地精炸弹。\n\t\t\t<b>戰吼：</b>召喚一個\n0/2哥布林炸彈\n\t\t"
      }
    },
