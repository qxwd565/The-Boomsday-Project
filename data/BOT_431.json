      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Das einzige Flugmanöver, das man als Goblin können muss, ist die Bruchlandung."
          },
          "enUS": {
            "present": true,
            "value": "She's on a bomb voyage."
          },
          "esES": {
            "present": true,
            "value": "Hacer parapente a la par que rotas sin control suena... ¡DIVERTIDO!"
          },
          "esMX": {
            "present": true,
            "value": "Surca los cielos como un pájaro... cargado de bombas."
          },
          "frFR": {
            "present": true,
            "value": "« Ça plane pour moi, ça plane pour moi, je suis la reine des bombes ! »"
          },
          "itIT": {
            "present": true,
            "value": "Le augurano sempre \"bomb voyage\"."
          },
          "jaJP": {
            "present": true,
            "value": "彼女の発進時のキメ台詞は「ボム・ボヤージュ」。"
          },
          "koKR": {
            "present": true,
            "value": "하늘에서 폭탄이 비처럼 내려와!"
          },
          "plPL": {
            "present": true,
            "value": "Gobliny też chcą latać!"
          },
          "ptBR": {
            "present": true,
            "value": "Porque ser especialista em construção dá muito mais trabalho."
          },
          "ruRU": {
            "present": true,
            "value": "Воздушный спорт – это просто огонь!"
          },
          "thTH": {
            "present": true,
            "value": "เธอกำลังสนุกระเบิดระเบ้อ[b]กับการเดินทาง"
          },
          "zhCN": {
            "present": true,
            "value": "希望她能平安抵达投弹点。"
          },
          "zhTW": {
            "present": true,
            "value": "這個發明又叫做飛飛飛飛飛飛飛機。"
          }
        },
        "textContent": "\n\t\t\tDas einzige Flugmanöver, das man als Goblin können muss, ist die Bruchlandung.\n\t\t\tShe's on a bomb voyage.\n\t\t\tHacer parapente a la par que rotas sin control suena... ¡DIVERTIDO!\n\t\t\tSurca los cielos como un pájaro... cargado de bombas.\n\t\t\t« Ça plane pour moi, ça plane pour moi, je suis la reine des bombes ! »\n\t\t\tLe augurano sempre \"bomb voyage\".\n\t\t\t彼女の発進時のキメ台詞は「ボム・ボヤージュ」。\n\t\t\t하늘에서 폭탄이 비처럼 내려와!\n\t\t\tGobliny też chcą latać!\n\t\t\tPorque ser especialista em construção dá muito mais trabalho.\n\t\t\tВоздушный спорт – это просто огонь!\n\t\t\tเธอกำลังสนุกระเบิดระเบ้อ[b]กับการเดินทาง\n\t\t\t希望她能平安抵达投弹点。\n\t\t\t這個發明又叫做飛飛飛飛飛飛飛機。\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
