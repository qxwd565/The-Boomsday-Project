          "ruRU": {
            "present": true,
            "value": "СОСТАВ: ЗВЕЗДНАЯ ВЗВЕСЬ, КРАСИТЕЛЬ «СИНИЙ №1», ИДЕНТИЧНЫЕ НАТУРАЛЬНЫМ ИСКУССТВЕННЫЕ ВКУСОВЫЕ ДОБАВКИ."
          },
          "thTH": {
            "present": true,
            "value": "ส่วนผสม: ผลผลิตจากดวงดาว,  สีผสมอาหารสีน้ำเงิน, แต่งกลิ่นและรสสังเคราะห์เลียน[b]แบบธรรมชาติ"
          },
          "zhCN": {
            "present": true,
