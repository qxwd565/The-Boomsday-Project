      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Bei unebenen Flächen sieht er rot."
          },
          "enUS": {
            "present": true,
            "value": "Leave them alone for two minutes and they go right into sleep mode."
          },
          "esES": {
            "present": true,
            "value": "Esto... Vale, técnicamente es un toro mecánico, pero no es lo que uno se esperaría."
          },
          "esMX": {
            "present": true,
            "value": "El terror de los toreros en el mundo de la construcción."
          },
          "frFR": {
            "present": true,
            "value": "À force de racler la poussière, il a les yeux tout rouges."
          },
          "itIT": {
            "present": true,
            "value": "Ha una grossa benna e non ha paura di utilizzarla."
          },
          "jaJP": {
            "present": true,
            "value": "ブル・ドーザー！メカンガルー！コメカンガルー！只今惨状（アチョー！ヒョヒョヒョヒョ）"
          },
          "koKR": {
            "present": true,
            "value": "2분 동안 내버려 두면 대기 상태에 돌입합니다."
          },
          "plPL": {
            "present": true,
            "value": "Dzięki temu wynalazkowi korrida stanie się humanitarna."
          },
          "ptBR": {
            "present": true,
            "value": "Se você não mexer com ele por dois minutos, ele entram no modo soneca."
          },
          "ruRU": {
            "present": true,
            "value": "Если оставить его в покое на пару минут, он сразу же переходит в режим сна."
          },
          "thTH": {
            "present": true,
            "value": "เจ้าของเดียวกับผลิตภัณฑ์[b]การเกษตรตรา \"หัววัวรถไถ\""
          },
          "zhCN": {
            "present": true,
            "value": "放着不动两分钟后，会自动进入休眠模式。"
          },
          "zhTW": {
            "present": true,
            "value": "放著不動兩分鐘就會進入休眠模式。"
          }
        },
        "textContent": "\n\t\t\tBei unebenen Flächen sieht er rot.\n\t\t\tLeave them alone for two minutes and they go right into sleep mode.\n\t\t\tEsto... Vale, técnicamente es un toro mecánico, pero no es lo que uno se esperaría.\n\t\t\tEl terror de los toreros en el mundo de la construcción.\n\t\t\tÀ force de racler la poussière, il a les yeux tout rouges.\n\t\t\tHa una grossa benna e non ha paura di utilizzarla.\n\t\t\tブル・ドーザー！メカンガルー！コメカンガルー！只今惨状（アチョー！ヒョヒョヒョヒョ）\n\t\t\t2분 동안 내버려 두면 대기 상태에 돌입합니다.\n\t\t\tDzięki temu wynalazkowi korrida stanie się humanitarna.\n\t\t\tSe você não mexer com ele por dois minutos, ele entram no modo soneca.\n\t\t\tЕсли оставить его в покое на пару минут, он сразу же переходит в режим сна.\n\t\t\tเจ้าของเดียวกับผลิตภัณฑ์[b]การเกษตรตรา \"หัววัวรถไถ\"\n\t\t\t放着不动两分钟后，会自动进入休眠模式。\n\t\t\t放著不動兩分鐘就會進入休眠模式。\n\t\t"
      },
