      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "„Was für eine Ironie. Er konnte andere wiederverwerten, aber nicht sich selbst.“"
          },
          "enUS": {
            "present": true,
            "value": "Ironic. It could recycle others, but not itself."
          },
          "esES": {
            "present": true,
            "value": "Puede reciclar a otros, pero no reciclarse a sí mismo... Qué ironía..."
          },
          "esMX": {
            "present": true,
            "value": "Irónico. Reciclaba a otros, pero no a sí mismo."
          },
          "frFR": {
            "present": true,
            "value": "Quelle ironie. Il peut tout recycler, sauf lui-même."
          },
          "itIT": {
            "present": true,
            "value": "Ironico: è capace di riciclare il resto, ma non se stesso."
          },
          "jaJP": {
            "present": true,
            "value": "皮肉なことだ。他者をリサイクルできても、自分自身はリサイクルできなかった。"
          },
          "koKR": {
            "present": true,
            "value": "자기 자신은 청소할 수 없습니다."
          },
          "plPL": {
            "present": true,
            "value": "Sprawna utylizacja odpadów nie jest priorytetem dla wynalazców z Laboratorium Huka."
          },
          "ptBR": {
            "present": true,
            "value": "Que ironia. Pôde reciclar os outros, mas não a si mesmo."
          },
          "ruRU": {
            "present": true,
            "value": "Какая ирония. Он мог утилизировать кого угодно, но не себя."
          },
          "thTH": {
            "present": true,
            "value": "น่าเศร้า มันรีไซเคิลคนอื่นได้ แต่รีไซเคิลตัวเองไม่ได้"
          },
          "zhCN": {
            "present": true,
            "value": "他有只蟑螂小伙伴，还有个会飞的女朋友。"
          },
          "zhTW": {
            "present": true,
            "value": "諷刺的是，它可以回收其他東西，但卻不能回收自己。"
          }
        },
        "textContent": "\n\t\t\t„Was für eine Ironie. Er konnte andere wiederverwerten, aber nicht sich selbst.“\n\t\t\tIronic. It could recycle others, but not itself.\n\t\t\tPuede reciclar a otros, pero no reciclarse a sí mismo... Qué ironía...\n\t\t\tIrónico. Reciclaba a otros, pero no a sí mismo.\n\t\t\tQuelle ironie. Il peut tout recycler, sauf lui-même.\n\t\t\tIronico: è capace di riciclare il resto, ma non se stesso.\n\t\t\t皮肉なことだ。他者をリサイクルできても、自分自身はリサイクルできなかった。\n\t\t\t자기 자신은 청소할 수 없습니다.\n\t\t\tSprawna utylizacja odpadów nie jest priorytetem dla wynalazców z Laboratorium Huka.\n\t\t\tQue ironia. Pôde reciclar os outros, mas não a si mesmo.\n\t\t\tКакая ирония. Он мог утилизировать кого угодно, но не себя.\n\t\t\tน่าเศร้า มันรีไซเคิลคนอื่นได้ แต่รีไซเคิลตัวเองไม่ได้\n\t\t\t他有只蟑螂小伙伴，还有个会飞的女朋友。\n\t\t\t諷刺的是，它可以回收其他東西，但卻不能回收自己。\n\t\t"
      },
