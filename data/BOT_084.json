    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Violet Haze"
          },
          "koKR": {
            "present": true,
            "value": "보랏빛 연무"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tVioletter Dunst\n\t\t\tViolet Haze\n\t\t\tNeblina violeta\n\t\t\tNeblina violeta\n\t\t\tBrume violette\n\t\t\tFoschia Violacea\n\t\t\t紫の煙霧\n\t\t\t보랏빛 연무\n\t\t\tFioletowa mgła\n\t\t\tNévoa Violeta\n\t\t\tЛиловые пары\n\t\t\tหมอกควันสีม่วง\n\t\t\t紫色烟雾\n\t\t\t迷幻紫煙\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Add 2 random <b>Deathrattle</b> cards to_your hand."
          },
          "koKR": {
            "present": true,
            "value": "무작위 <b>죽음의_메아리</b> 카드 2장을 내 손으로 가져옵니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tErhaltet 2 zufällige <b>Todesröcheln</b>-Karten auf die Hand.\n\t\t\tAdd 2 random <b>Deathrattle</b> cards to_your hand.\n\t\t\t[x]Añade 2 cartas\ncon <b>Último aliento</b>\naleatorias a tu mano.\n\t\t\tAgrega 2 cartas con <b>Estertor</b> aleatorias a tu mano.\n\t\t\tAjoute 2_cartes aléatoires avec <b>Râle d’agonie</b> dans votre main.\n\t\t\tMette nella tua mano due carte con <b>Rantolo di Morte</b> casuali.\n\t\t\t[x]<b>断末魔</b>を持つ\nランダムなカード2枚を\n自分の手札に追加する。\n\t\t\t무작위 <b>죽음의_메아리</b> 카드 2장을 내 손으로 가져옵니다.\n\t\t\tDodaj dwie losowe karty z <b>Agonią</b> do twojej ręki.\n\t\t\tAdicione 2 cards aleatórios com <b>Último Suspiro</b> à sua mão.\n\t\t\tВы кладете в руку 2 случайные карты с_<b>«Предсмертным хрипом»</b>.\n\t\t\tสุ่มเพิ่มการ์ด_<b>เสียงสุดท้าย</b> 2_ใบในมือคุณ\n\t\t\t随机将两张<b>亡语</b>牌置入你的\n手牌。\n\t\t\t放2張隨機\n<b>死亡之聲</b>牌到你的手中\n\t\t"
      }
    },
    "currentStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Violet Haze"
          },
          "koKR": {
            "present": true,
            "value": "보랏빛 연무"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\tVioletter Dunst\n\t\tViolet Haze\n\t\tNeblina violeta\n\t\tNeblina violeta\n\t\tBrume violette\n\t\tFoschia Violacea\n\t\t紫の煙霧\n\t\t보랏빛 연무\n\t\tFioletowa mgła\n\t\tNévoa Violeta\n\t\tЛиловые пары\n\t\tหมอกควันสีม่วง\n\t\t紫色烟雾\n\t\t迷幻紫煙\n\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Add 2 random <b>Deathrattle</b> cards to_your hand."
          },
          "koKR": {
            "present": true,
            "value": "무작위 <b>죽음의_메아리</b> 카드 2장을 내 손으로 가져옵니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\tErhaltet 2 zufällige <b>Todesröcheln</b>-Karten auf die Hand.\n\t\tAdd 2 random <b>Deathrattle</b> cards to_your hand.\n\t\t[x]Añade 2 cartas\ncon <b>Último aliento</b>\naleatorias a tu mano.\n\t\tAgrega 2 cartas con <b>Estertor</b> aleatorias a tu mano.\n\t\tAjoute 2_cartes aléatoires avec <b>Râle d’agonie</b> dans votre main.\n\t\tMette nella tua mano due carte con <b>Rantolo di Morte</b> casuali.\n\t\t[x]<b>断末魔</b>を持つ\nランダムなカード2枚を\n自分の手札に追加する。\n\t\t무작위 <b>죽음의_메아리</b> 카드 2장을 내 손으로 가져옵니다.\n\t\tDodaj dwie losowe karty z <b>Agonią</b> do twojej ręki.\n\t\tAdicione 2 cards aleatórios com <b>Último Suspiro</b> à sua mão.\n\t\tВы кладете в руку 2 случайные карты с_<b>«Предсмертным хрипом»</b>.\n\t\tสุ่มเพิ่มการ์ด <b>เสียงสุดท้าย</b>_2_ใบ[b]ในมือคุณ\n\t\t随机将两张<b>亡语</b>牌置入你的\n手牌。\n\t\t放2張隨機\n<b>死亡之聲</b>牌到你的手中\n\t"
      }
    },
