    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Menacing Nimbus"
          },
          "koKR": {
            "present": true,
            "value": "성난 먹구름"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tDrohender Nimbus\n\t\t\tMenacing Nimbus\n\t\t\tNimbo amenazador\n\t\t\tNimbo amenazante\n\t\t\tNimbus menaçant\n\t\t\tNembo Minaccioso\n\t\t\t荒ぶる雨雲\n\t\t\t성난 먹구름\n\t\t\tMroczny nimbostratus\n\t\t\tNimbo Ameaçador\n\t\t\tГрозовое облако\n\t\t\tเมฆนิมบัสคุกคาม\n\t\t\t凶恶的雨云\n\t\t\t兇惡的雨雲\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Add a random Elemental to your hand."
          },
          "koKR": {
            "present": true,
            "value": "<b>전투의 함성:</b>\n무작위 정령 하나를\n내 손으로 가져옵니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Kampfschrei:</b> Erhaltet\neinen zufälligen Elementar auf die Hand.\n\t\t\t<b>Battlecry:</b> Add a random Elemental to your hand.\n\t\t\t[x]<b>Grito de batalla:</b> Añade\nun elemental aleatorio\na tu mano.\n\t\t\t<b>Grito de batalla:</b> agrega un Elemental aleatorio a tu mano.\n\t\t\t<b>Cri de guerre_:</b> ajoute un élémentaire aléatoire dans votre main.\n\t\t\t[x]<b>Grido di Battaglia:</b>\nmette nella tua mano un\nElementale casuale.\n\t\t\t[x]<b>雄叫び:</b>\nランダムなエレメンタル\n1体を自分の手札に\n追加する。\n\t\t\t<b>전투의 함성:</b>\n무작위 정령 하나를\n내 손으로 가져옵니다.\n\t\t\t<b>Okrzyk bojowy:</b> Dodaj losowego Żywiołaka\ndo twojej ręki.\n\t\t\t<b>Grito de Guerra:</b> Adicione um Elemental aleatório à sua mão.\n\t\t\t<b>Боевой клич:</b> вы кладете в руку случайного элементаля.\n\t\t\t<b>คำรามสู้ศึก:</b> สุ่มเพิ่มการ์ดวิญญาณธาตุ[b]หนึ่งใบในมือคุณ\n\t\t\t<b>战吼：</b>将一张随机元素牌置入你的手牌。\n\t\t\t<b>戰吼：</b>放一個隨機\n元素到你的手中\n\t\t"
      }
    },
