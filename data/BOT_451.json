    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Voltaic Burst"
          },
          "koKR": {
            "present": true,
            "value": "볼타 폭발"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tFunkenentladung\n\t\t\tVoltaic Burst\n\t\t\tDescarga voltaica\n\t\t\tRáfaga de voltios\n\t\t\tExplosion voltaïque\n\t\t\tScarica Voltaica\n\t\t\t電流火花\n\t\t\t볼타 폭발\n\t\t\tWybuch woltaiczny\n\t\t\tEstouro Voltaico\n\t\t\tПеренапряжение\n\t\t\tประกายไฟพลุ่งพล่าน\n\t\t\t流电爆裂\n\t\t\t電路走火\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Summon two 1/1 Sparks with <b>Rush</b>. <b>Overload:</b> (1)"
          },
          "koKR": {
            "present": true,
            "value": "[x]<b>속공</b> 능력이 있는 1/1\n불꽃을 둘 소환합니다.\n<b>과부하:</b> (1)"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tRuft 2 Funken (1/1)\nmit <b>Eifer</b> herbei. <b>Überladung:</b> (1)\n\t\t\tSummon two 1/1 Sparks with <b>Rush</b>. <b>Overload:</b> (1)\n\t\t\t[x]Invoca dos chispas\n1/1 con <b>Embestir</b>.\n<b>Sobrecarga:</b> (1).\n\t\t\tInvoca dos Chispas 1/1 con <b>Acometida</b>. <b>Sobrecarga:</b> (1)\n\t\t\tInvoque deux étincelles_1/1 avec <b>Ruée</b>. <b>Surcharge_:</b>_(1)\n\t\t\t[x]Evoca due Scintille\n1/1 con <b>Assalto</b>.\n<b>Sovraccarico:</b> (1)\n\t\t\t[x]<b>急襲</b>を持つ\n1/1の「スパーク」を\n2体召喚する。\n<b>オーバーロード:</b>（1）\n\t\t\t[x]<b>속공</b> 능력이 있는 1/1\n불꽃을 둘 소환합니다.\n<b>과부하:</b> (1)\n\t\t\tPrzyzwij dwie Iskry 1/1 ze <b>Zrywem</b>.\n<b>Przeciążenie:</b> (1)\n\t\t\tEvoque duas Faíscas 1/1 com <b>Rapidez</b>. <b>Sobrecarga:</b> (1)\n\t\t\tПризывает две искры 1/1 с_<b>«Натиском»</b>.\n<b>Перегрузка:</b> (1)\n\t\t\tเรียกประกายไฟ 1/1 ที่มี <b>จู่โจม</b> สองตัว <b>โอเวอร์โหลด:</b> (1)\n\t\t\t召唤两个1/1并具有<b>突袭</b>的“火花”。<b>过载：</b>（1）\n\t\t\t召喚二個\n有<b>衝刺</b>的1/1火花\n<b>超載：</b>(1)\n\t\t"
      }
    },
