    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Replicating Menace"
          },
          "koKR": {
            "present": true,
            "value": "증식하는 위협"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tModulare Bedrohung\n\t\t\tReplicating Menace\n\t\t\tAmenaza replicante\n\t\t\tAmenaza replicante\n\t\t\tMenace répliquante\n\t\t\tMinaccia Replicante\n\t\t\t自己増殖型メナス\n\t\t\t증식하는 위협\n\t\t\tReplikator bojowy\n\t\t\tAmeaça Replicante\n\t\t\tРепликатор\n\t\t\tหุ่นพิฆาตจำลองร่าง\n\t\t\t量产型恐吓机\n\t\t\t合體的威脅者\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Magnetic</b>\n<b>Deathrattle:</b> Summon three 1/1 Microbots."
          },
          "koKR": {
            "present": true,
            "value": "[x]<b>합체</b>, <b>죽음의 메아리:</b>\n1/1 초소형 로봇을\n셋 소환합니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Magnetisch</b>. <b>Todesröcheln:</b> Ruft 3 Mikrobots (1/1) herbei.\n\t\t\t<b>Magnetic</b>\n<b>Deathrattle:</b> Summon three 1/1 Microbots.\n\t\t\t[x]<b>Magnetismo</b>\n<b>Último aliento:</b> Invoca\ntres microbots 1/1.\n\t\t\t<b>Magnetismo</b>\n<b>Estertor:</b> invoca tres Microbots 1/1.\n\t\t\t<b>Magnétisme</b>\n<b>Râle d’agonie_:</b> invoque trois_microbots_1/1.\n\t\t\t[x]<b>Magnetismo</b>.\n<b>Rantolo di Morte:</b>\n__evoca tre Microbot 1/1.\n\t\t\t[x]<b>超電磁</b>\n<b>断末魔:</b>\n1/1の「マイクロロボ」を\n3体召喚する。\n\t\t\t[x]<b>합체</b>, <b>죽음의 메아리:</b>\n1/1 초소형 로봇을\n셋 소환합니다.\n\t\t\t<b>Magnetyzm</b>\n<b>Agonia:</b> Przyzwij trzy Mikroboty 1/1.\n\t\t\t<b>Magnético</b>\n<b>Último Suspiro:</b> Evoque três Microrrobôs 1/1.\n\t\t\t<b>Магнетизм</b>\n<b>Предсмертный хрип:</b> призывает трех микроботов 1/1.\n\t\t\t<b>แม่เหล็ก</b>, <b>เสียงสุดท้าย:</b>[b]เรียกไมโครบอท_1/1 สามตัว\n\t\t\t<b>磁力，亡语：</b>召唤三个1/1的微型机器人。\n\t\t\t[x]<b>合體</b>\n<b>死亡之聲：</b>召喚三個\n1/1微型機器人\n\t\t"
      }
    },
