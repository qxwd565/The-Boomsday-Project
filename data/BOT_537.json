      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Für alle, denen der Arzt zu mehr Eisen rät."
          },
          "enUS": {
            "present": true,
            "value": "When you need more iron in your diet."
          },
          "esES": {
            "present": true,
            "value": "Para esos momentos en los que necesitas más hierro en tu dieta."
          },
          "esMX": {
            "present": true,
            "value": "Para cuando necesitas incorporar más hierro en tu dieta."
          },
          "frFR": {
            "present": true,
            "value": "Boum crée des robots. Boum fusionne avec les robots. Boum invoque des dinosaures. Les dinosaures fusionnent avec les robots. Boum crée le robosaure…"
          },
          "itIT": {
            "present": true,
            "value": "Quando serve più ferro nella propria dieta."
          },
          "jaJP": {
            "present": true,
            "value": "鉄分が不足しがちな食生活に。"
          },
          "koKR": {
            "present": true,
            "value": "식단에 철분이 더 필요할 때 안성맞춤입니다."
          },
          "plPL": {
            "present": true,
            "value": "Jedz je trzy razy w tygodniu, a wzbogacisz dietę w żelazo."
          },
          "ptBR": {
            "present": true,
            "value": "Para o caso de você precisar de mais ferro na sua dieta."
          },
          "ruRU": {
            "present": true,
            "value": "Обогатите свой рацион железом!"
          },
          "thTH": {
            "present": true,
            "value": "สำหรับเวลาที่คุณอยาก[b]เพิ่มธาตุเหล็กให้ร่างกาย"
          },
          "zhCN": {
            "present": true,
            "value": "补铁补血，健康之选。"
          },
          "zhTW": {
            "present": true,
            "value": "需要攝取更多鐵的話，這是最佳來源。"
          }
        },
        "textContent": "\n\t\t\tFür alle, denen der Arzt zu mehr Eisen rät.\n\t\t\tWhen you need more iron in your diet.\n\t\t\tPara esos momentos en los que necesitas más hierro en tu dieta.\n\t\t\tPara cuando necesitas incorporar más hierro en tu dieta.\n\t\t\tBoum crée des robots. Boum fusionne avec les robots. Boum invoque des dinosaures. Les dinosaures fusionnent avec les robots. Boum crée le robosaure…\n\t\t\tQuando serve più ferro nella propria dieta.\n\t\t\t鉄分が不足しがちな食生活に。\n\t\t\t식단에 철분이 더 필요할 때 안성맞춤입니다.\n\t\t\tJedz je trzy razy w tygodniu, a wzbogacisz dietę w żelazo.\n\t\t\tPara o caso de você precisar de mais ferro na sua dieta.\n\t\t\tОбогатите свой рацион железом!\n\t\t\tสำหรับเวลาที่คุณอยาก[b]เพิ่มธาตุเหล็กให้ร่างกาย\n\t\t\t补铁补血，健康之选。\n\t\t\t需要攝取更多鐵的話，這是最佳來源。\n\t\t"
      },
