    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Gloop Sprayer"
          },
          "koKR": {
            "present": true,
            "value": "수액 살포자"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tGlibbersprüher\n\t\t\tGloop Sprayer\n\t\t\tIrrigador de babas\n\t\t\tPropagador de viscosidad\n\t\t\tPulvérisateur de gloup\n\t\t\tSpargimuco\n\t\t\tべとべとスプレーマン\n\t\t\t수액 살포자\n\t\t\tSzlamolejca\n\t\t\tJateador de Glub\n\t\t\tХлюпонизатор\n\t\t\tนักพ่นกลู๊ป\n\t\t\t黏液喷射者\n\t\t\t黏液噴灑者\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Summon a copy of each adjacent minion."
          },
          "koKR": {
            "present": true,
            "value": "<b>전투의 함성:</b>\n양옆의 하수인들을 복사하여 소환합니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Kampfschrei:</b> Ruft eine Kopie jedes benachbarten Dieners herbei.\n\t\t\t<b>Battlecry:</b> Summon a copy of each adjacent minion.\n\t\t\t[x]<b>Grito de batalla:</b>\nInvoca una copia de cada\nesbirro adyacente.\n\t\t\t<b>Grito de batalla:</b> invoca una copia de cada esbirro adyacente.\n\t\t\t<b>Cri de guerre_:</b> invoque une copie de chaque serviteur adjacent.\n\t\t\t[x]<b>Grido di Battaglia:</b>\nevoca una copia dei\nservitori adiacenti.\n\t\t\t[x]<b>雄叫び:</b>\n隣接する各ミニオンの\nコピーを1体ずつ\n召喚する。\n\t\t\t<b>전투의 함성:</b>\n양옆의 하수인들을 복사하여 소환합니다.\n\t\t\t<b>Okrzyk bojowy:</b> Przyzwij kopię każdego sąsiedniego stronnika.\n\t\t\t<b>Grito de Guerra:</b> Evoque uma cópia de cada lacaio adjacente a este.\n\t\t\t<b>Боевой клич:</b> призывает копии существ по обе стороны от себя.\n\t\t\t<b>คำรามสู้ศึก:</b> เรียกร่าง[b]ก๊อปปี้ของมินเนี่ยนทั้งหมด[b]ที่อยู่ติดกับมินเนี่ยนตัวนี้\n\t\t\t<b>战吼：</b>\n为相邻的随从各召唤一个复制。\n\t\t\t<b>戰吼：</b>召喚兩側的\n手下的分身\n\t\t"
      }
    },
