          },
          "ruRU": {
            "present": true,
            "value": "Секрет, секрет... Какой секрет? Секрета нет... и плана нет!"
          },
          "thTH": {
            "present": true,
            "value": "ความลับก็คือ... เราไม่มีแผน!"
