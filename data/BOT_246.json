    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Beakered Lightning"
          },
          "koKR": {
            "present": true,
            "value": "비커에 담긴 번개"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tDestillierter Blitz\n\t\t\tBeakered Lightning\n\t\t\tRelámpago envasado\n\t\t\tRelámpago capturado\n\t\t\tFoudre en bécher\n\t\t\tFulmine Contenuto\n\t\t\tガラス管入りの稲妻\n\t\t\t비커에 담긴 번개\n\t\t\tZabutelkowana błyskawica\n\t\t\tRaio Encapsulado\n\t\t\tМолния в колбе\n\t\t\tสายฟ้าในบีกเกอร์\n\t\t\t瓶装闪电\n\t\t\t封裝的閃電\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Deal $1 damage to all minions. <b>Overload:</b> (2)"
          },
          "koKR": {
            "present": true,
            "value": "<b>모든</b> 하수인에게 피해를 $1 줍니다. <b>과부하:</b> (2)"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tFügt allen Dienern $1_Schaden zu. <b>Überladung:</b> (2)\n\t\t\tDeal $1 damage to all minions. <b>Overload:</b> (2)\n\t\t\tInflige $1 p. de daño\na todos los esbirros. <b>Sobrecarga:</b> (2).\n\t\t\tInflige $1 de daño a todos los esbirros. <b>Sobrecarga:</b> (2)\n\t\t\tInflige_$1_|4(point,points)_de_dégâts à tous les serviteurs. <b>Surcharge_:</b>_(2)\n\t\t\tInfligge $1 |4(danno,danni) a TUTTI i servitori. <b>Sovraccarico:</b> (2)\n\t\t\t[x]全てのミニオンに\n$1ダメージを与える。\n<b>オーバーロード:</b>（2）\n\t\t\t<b>모든</b> 하수인에게 피해를 $1 줍니다. <b>과부하:</b> (2)\n\t\t\tZadaj $1 pkt. obrażeń wszystkim stronnikom. <b>Przeciążenie:</b> (2)\n\t\t\tCause $1 de dano a todos os lacaios. <b>Sobrecarga:</b> (2)\n\t\t\tНаносит $1 ед. урона всем существам. <b>Перегрузка:</b> (2)\n\t\t\tสร้างความเสียหาย $1_แต้มให้มินเนี่ยนทั้งหมด <b>โอเวอร์โหลด:</b> (2)\n\t\t\t对所有随从造成$1点伤害。\n<b>过载：</b>（2）\n\t\t\t對全部手下\n造成$1點傷害\n<b>超載：</b>(2)\n\t\t"
      }
    },
