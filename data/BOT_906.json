      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Wochenlang haben sie versucht, eine Tarnversion mit Verstohlenheit zu erschaffen, aber irgendwann hat es auch ihnen_... eingeleuchtet."
          },
          "enUS": {
            "present": true,
            "value": "They tried for weeks to make a stealth version, but eventually decided to just let it glow."
          },
          "esES": {
            "present": true,
            "value": "Durante semanas, intentaron crear una versión que se pudiera camuflar, pero al final decidieron dejarle brillar."
          },
          "esMX": {
            "present": true,
            "value": "Pasaron semanas tratando de hacer una versión sigilosa, pero al final decidieron dejar que brillara."
          },
          "frFR": {
            "present": true,
            "value": "Ils ont tenté de l’améliorer pendant des semaines mais se sont vite retrouvés à court d’idées lumineuses."
          },
          "itIT": {
            "present": true,
            "value": "Hanno provato per settimane a crearne una versione furtiva, ma l'idea si è rivelata poco brillante."
          },
          "jaJP": {
            "present": true,
            "value": "研究員たちは何週間もかけてステルス性能を持たせようと試行錯誤したが、結局あきらめて好きに光らせるようにした。"
          },
          "koKR": {
            "present": true,
            "value": "물지 않아요. 빛이 나서 발광입니다."
          },
          "plPL": {
            "present": true,
            "value": "Projekt zakładał budowę niewykrywalnego bota do infiltracji, ale coś poszło nie tak."
          },
          "ptBR": {
            "present": true,
            "value": "Pensaram em fazer uma versão com furtividade, mas mudaram de ideia quando alguém deu uma luz."
          },
          "ruRU": {
            "present": true,
            "value": "После долгих попыток сделать более незаметную модель инженеры решили: да гори оно синим пламенем!"
          },
          "thTH": {
            "present": true,
            "value": "พวกเขาเคยพยายามสร้างรุ่นที่ซ่อนตัวได้ แต่สุดท้ายก็ตัดสินใจ[b]ปล่อยให้มันได้เปล่งประกาย"
          },
          "zhCN": {
            "present": true,
            "value": "设计师耗费数周试图打造潜行版，最终还是因为罩子太亮而放弃了。"
          },
          "zhTW": {
            "present": true,
            "value": "花了好幾週開發潛行功能，但因為太光亮只好放棄了。"
          }
        },
        "textContent": "\n\t\t\tWochenlang haben sie versucht, eine Tarnversion mit Verstohlenheit zu erschaffen, aber irgendwann hat es auch ihnen_... eingeleuchtet.\n\t\t\tThey tried for weeks to make a stealth version, but eventually decided to just let it glow.\n\t\t\tDurante semanas, intentaron crear una versión que se pudiera camuflar, pero al final decidieron dejarle brillar.\n\t\t\tPasaron semanas tratando de hacer una versión sigilosa, pero al final decidieron dejar que brillara.\n\t\t\tIls ont tenté de l’améliorer pendant des semaines mais se sont vite retrouvés à court d’idées lumineuses.\n\t\t\tHanno provato per settimane a crearne una versione furtiva, ma l'idea si è rivelata poco brillante.\n\t\t\t研究員たちは何週間もかけてステルス性能を持たせようと試行錯誤したが、結局あきらめて好きに光らせるようにした。\n\t\t\t물지 않아요. 빛이 나서 발광입니다.\n\t\t\tProjekt zakładał budowę niewykrywalnego bota do infiltracji, ale coś poszło nie tak.\n\t\t\tPensaram em fazer uma versão com furtividade, mas mudaram de ideia quando alguém deu uma luz.\n\t\t\tПосле долгих попыток сделать более незаметную модель инженеры решили: да гори оно синим пламенем!\n\t\t\tพวกเขาเคยพยายามสร้างรุ่นที่ซ่อนตัวได้ แต่สุดท้ายก็ตัดสินใจ[b]ปล่อยให้มันได้เปล่งประกาย\n\t\t\t设计师耗费数周试图打造潜行版，最终还是因为罩子太亮而放弃了。\n\t\t\t花了好幾週開發潛行功能，但因為太光亮只好放棄了。\n\t\t"
      },
