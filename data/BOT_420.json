      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Vorsicht beim Anbau von Treants: Wenn sie ausschlagen, ist das durchaus wörtlich zu nehmen."
          },
          "enUS": {
            "present": true,
            "value": "We'll put a happy tree right here... and give him a little friend."
          },
          "esES": {
            "present": true,
            "value": "Ponemos a un tronqui por aquí y a otro tronqui por allá..."
          },
          "esMX": {
            "present": true,
            "value": "El paisajismo es muy relajante... siempre y cuando el paisaje no cobre vida."
          },
          "frFR": {
            "present": true,
            "value": "Ce ne sont pas des arbres, ce sont des tréants."
          },
          "itIT": {
            "present": true,
            "value": "\"Mettiamo un bell'alberello qui... e poi piantiamo vicino un amichetto.\""
          },
          "jaJP": {
            "present": true,
            "value": "ここに幸せな木を植えて…ここにお友達の木を植えてあげましょう。ね、簡単でしょ？"
          },
          "koKR": {
            "present": true,
            "value": "여기에 방긋방긋 웃는 나무를 심어주고... 그 옆에 친구도 만들어 줘 볼게요."
          },
          "plPL": {
            "present": true,
            "value": "Dobra wprawka przed terraformacją innych planet."
          },
          "ptBR": {
            "present": true,
            "value": "Vamos colocar uma árvore feliz aqui... e colocar um amiguinho do lado."
          },
          "ruRU": {
            "present": true,
            "value": "Два радостных саженца дадут жизнь веселому лесу, а там и счастливые друзья подтянутся."
          },
          "thTH": {
            "present": true,
            "value": "เราจะวางต้นไม้น้อยๆ ไว้ตรงนี้... แล้ววางอีกต้นนึงให้เป็นเพื่อนกัน"
          },
          "zhCN": {
            "present": true,
            "value": "在我的后园，可以看见墙外有两株树，一株是树人，还有一株也是树人。"
          },
          "zhTW": {
            "present": true,
            "value": "我們在這裡加上一棵快樂的小樹，再給它一個朋友。"
          }
        },
        "textContent": "\n\t\t\tVorsicht beim Anbau von Treants: Wenn sie ausschlagen, ist das durchaus wörtlich zu nehmen.\n\t\t\tWe'll put a happy tree right here... and give him a little friend.\n\t\t\tPonemos a un tronqui por aquí y a otro tronqui por allá...\n\t\t\tEl paisajismo es muy relajante... siempre y cuando el paisaje no cobre vida.\n\t\t\tCe ne sont pas des arbres, ce sont des tréants.\n\t\t\t\"Mettiamo un bell'alberello qui... e poi piantiamo vicino un amichetto.\"\n\t\t\tここに幸せな木を植えて…ここにお友達の木を植えてあげましょう。ね、簡単でしょ？\n\t\t\t여기에 방긋방긋 웃는 나무를 심어주고... 그 옆에 친구도 만들어 줘 볼게요.\n\t\t\tDobra wprawka przed terraformacją innych planet.\n\t\t\tVamos colocar uma árvore feliz aqui... e colocar um amiguinho do lado.\n\t\t\tДва радостных саженца дадут жизнь веселому лесу, а там и счастливые друзья подтянутся.\n\t\t\tเราจะวางต้นไม้น้อยๆ ไว้ตรงนี้... แล้ววางอีกต้นนึงให้เป็นเพื่อนกัน\n\t\t\t在我的后园，可以看见墙外有两株树，一株是树人，还有一株也是树人。\n\t\t\t我們在這裡加上一棵快樂的小樹，再給它一個朋友。\n\t\t"
      },
