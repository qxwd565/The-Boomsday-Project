      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Die ursprünglichen Experimente mit Tarnborsten waren wenig erfolgreich."
          },
          "enUS": {
            "present": true,
            "value": "Her suit was fitted using a scale model."
          },
          "esES": {
            "present": true,
            "value": "Es muy desconfiada. Se podría decir que... todo le escama."
          },
          "esMX": {
            "present": true,
            "value": "Su traje se confeccionó con un modelo a escama."
          },
          "frFR": {
            "present": true,
            "value": "Au départ, elle cherchait juste à utiliser les propriétés des caméléons pour développer un système de camouflage. Mais l’expérience a mal tourné…"
          },
          "itIT": {
            "present": true,
            "value": "Adora scagliarsi negli esperimenti."
          },
          "jaJP": {
            "present": true,
            "value": "たとえ白衣を着こんでいても、邪悪な心は…黒く透ける。"
          },
          "koKR": {
            "present": true,
            "value": "비늘과 잘 어울리는 색깔의 옷을 고르기가 쉽지 않습니다."
          },
          "plPL": {
            "present": true,
            "value": "Ciągle strąca ogonem kolby i menzurki."
          },
          "ptBR": {
            "present": true,
            "value": "A técnica passou a ter uso militar depois que fez sucesso entre os antissociais."
          },
          "ruRU": {
            "present": true,
            "value": "«Что у тебя с кожей?» –_«Это чешуя.» –_«Не чеши больше так!»"
          },
          "thTH": {
            "present": true,
            "value": "\"พ่อของเธอทิ้งอุปกรณ์ชิ้นนี้[b]ไว้กับฉันก่อนเขาตาย ถึงเวลาส่งคืนให้เธอแล้ว ใช้ให้ดี\""
          },
          "zhCN": {
            "present": true,
            "value": "她这套衣服是依照鳞片模型剪裁的。"
          },
          "zhTW": {
            "present": true,
            "value": "她的鱗片本來就會隱形，腰上的裝置是隱形衣服用的。"
          }
        },
        "textContent": "\n\t\t\tDie ursprünglichen Experimente mit Tarnborsten waren wenig erfolgreich.\n\t\t\tHer suit was fitted using a scale model.\n\t\t\tEs muy desconfiada. Se podría decir que... todo le escama.\n\t\t\tSu traje se confeccionó con un modelo a escama.\n\t\t\tAu départ, elle cherchait juste à utiliser les propriétés des caméléons pour développer un système de camouflage. Mais l’expérience a mal tourné…\n\t\t\tAdora scagliarsi negli esperimenti.\n\t\t\tたとえ白衣を着こんでいても、邪悪な心は…黒く透ける。\n\t\t\t비늘과 잘 어울리는 색깔의 옷을 고르기가 쉽지 않습니다.\n\t\t\tCiągle strąca ogonem kolby i menzurki.\n\t\t\tA técnica passou a ter uso militar depois que fez sucesso entre os antissociais.\n\t\t\t«Что у тебя с кожей?» –_«Это чешуя.» –_«Не чеши больше так!»\n\t\t\t\"พ่อของเธอทิ้งอุปกรณ์ชิ้นนี้[b]ไว้กับฉันก่อนเขาตาย ถึงเวลาส่งคืนให้เธอแล้ว ใช้ให้ดี\"\n\t\t\t她这套衣服是依照鳞片模型剪裁的。\n\t\t\t她的鱗片本來就會隱形，腰上的裝置是隱形衣服用的。\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "Mauricio Herrera"
      }
    },
