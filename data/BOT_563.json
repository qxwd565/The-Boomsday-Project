      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Kandidat für die Wahl zum Mister Roboversum. Wenn er gewinnt, wird es vielleicht was mit der Schauspielkarriere und später mit der Politik."
          },
          "enUS": {
            "present": true,
            "value": "WAR! GEAR! What is it good for?"
          },
          "esES": {
            "present": true,
            "value": "Un imán para atraer problemas."
          },
          "esMX": {
            "present": true,
            "value": "Si no puede haber paz en el mundo… entonces que haya una buena máquina de guerra."
          },
          "frFR": {
            "present": true,
            "value": "Leur guerre, notre monde."
          },
          "itIT": {
            "present": true,
            "value": "Che guerra sia!"
          },
          "jaJP": {
            "present": true,
            "value": "不運にも踏み潰された研究員の悲鳴から名付けられた。"
          },
          "koKR": {
            "present": true,
            "value": "그래서 프로토콜 7이 대체 뭘까요?"
          },
          "plPL": {
            "present": true,
            "value": "Nikt nie wie, że w głębi metalowego serca jest pacyfistą."
          },
          "ptBR": {
            "present": true,
            "value": "Convidados com outro tipo de traje não poderão entrar."
          },
          "ruRU": {
            "present": true,
            "value": "Лаванда и боекостюм\nИзбавят от тревожных дум!"
          },
          "thTH": {
            "present": true,
            "value": "สงครามไม่เคยเปลี่ยน"
          },
          "zhCN": {
            "present": true,
            "value": "AMANI NAKUPENDA NAKUPENDA WE WE"
          },
          "zhTW": {
            "present": true,
            "value": "對戰五回合之後開始合體。"
          }
        },
        "textContent": "\n\t\t\tKandidat für die Wahl zum Mister Roboversum. Wenn er gewinnt, wird es vielleicht was mit der Schauspielkarriere und später mit der Politik.\n\t\t\tWAR! GEAR! What is it good for?\n\t\t\tUn imán para atraer problemas.\n\t\t\tSi no puede haber paz en el mundo… entonces que haya una buena máquina de guerra.\n\t\t\tLeur guerre, notre monde.\n\t\t\tChe guerra sia!\n\t\t\t不運にも踏み潰された研究員の悲鳴から名付けられた。\n\t\t\t그래서 프로토콜 7이 대체 뭘까요?\n\t\t\tNikt nie wie, że w głębi metalowego serca jest pacyfistą.\n\t\t\tConvidados com outro tipo de traje não poderão entrar.\n\t\t\tЛаванда и боекостюм\nИзбавят от тревожных дум!\n\t\t\tสงครามไม่เคยเปลี่ยน\n\t\t\tAMANI NAKUPENDA NAKUPENDA WE WE\n\t\t\t對戰五回合之後開始合體。\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "Dave Allsop"
      }
