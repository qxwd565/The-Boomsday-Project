    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Crystalsmith Kangor"
          },
          "koKR": {
            "present": true,
            "value": "수정대장장이 칸고르"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tKristallschmied Kangor\n\t\t\tCrystalsmith Kangor\n\t\t\tCristalero Kangor\n\t\t\tForjacristales Kangor\n\t\t\tForgecristal Kangor\n\t\t\tForgiacristalli Kangor\n\t\t\tクリスタル加工師ケンゴー\n\t\t\t수정대장장이 칸고르\n\t\t\tKrysztalista Kangor\n\t\t\tCristaleiro Kangor\n\t\t\tКристалломант Кангор\n\t\t\tคริสตัลสมิธแคงกอร์\n\t\t\t水晶工匠坎格尔\n\t\t\t水晶工匠崗古\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Divine Shield</b>, <b>Lifesteal</b>\nYour healing is doubled."
          },
          "koKR": {
            "present": true,
            "value": "<b>천상의 보호막</b>\n<b>생명력 흡수</b>\n내 치유량을 2배 증가시킵니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Gottesschild</b>, <b>Lebensentzug</b>. Eure Heilung ist verdoppelt.\n\t\t\t<b>Divine Shield</b>, <b>Lifesteal</b>\nYour healing is doubled.\n\t\t\t[x]<b>Escudo divino</b>\n <b>Robo de vida</b>\nSe duplica tu sanación.\n\t\t\t<b>Escudo divino</b>, <b>Robavida</b>\nTus sanaciones se duplican.\n\t\t\t<b>Vol de vie</b>\n<b>Bouclier divin</b>\nDouble vos soins.\n\t\t\t[x]<b>Scudo Divino</b>. <b>Furto Vitale</b>.\nLe tue cure sono raddoppiate.\n\t\t\t[x]<b>聖なる盾</b>、<b>生命奪取</b>\n自分の回復効果が\n2倍になる。\n\t\t\t<b>천상의 보호막</b>\n<b>생명력 흡수</b>\n내 치유량을 2배 증가시킵니다.\n\t\t\t<b>Boska tarcza</b>\n<b>Kradzież życia</b>\nPodwajasz wartość uzdrawiania.\n\t\t\t<b>Escudo Divino</b>\n<b>Roubar Vida</b>\nSua cura é duplicada.\n\t\t\t<b>Божественный щит</b>\n<b>Похищение жизни</b>. Вы восстанавливаете здоровье в двойном объеме.\n\t\t\t<b>โล่ศักดิ์สิทธิ์</b>, <b>สูบชีวิต</b> การฟื้นฟูพลังชีวิตของคุณ[b]มีผลเป็นสองเท่า\n\t\t\t<b>圣盾，吸血</b>\n你的治疗效果翻倍。\n\t\t\t<b>聖盾術</b>、<b>生命竊取</b>\n你的治療效果加倍\n\t\t"
      }
    },
