      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Es ist keine große Leuchte, aber bei den anderen Mechs ist es sehr beliebt."
          },
          "enUS": {
            "present": true,
            "value": "They're a little light-headed."
          },
          "esES": {
            "present": true,
            "value": "Es superocurrente; cada dos por tres, se le ilumina la bombilla."
          },
          "esMX": {
            "present": true,
            "value": "Sin dudas, una iluminada."
          },
          "frFR": {
            "present": true,
            "value": "C’est une tête d’ampoule."
          },
          "itIT": {
            "present": true,
            "value": "Sono dei tipi un po' allampati!"
          },
          "jaJP": {
            "present": true,
            "value": "こいつの存在は、周囲を明るくしてくれる。"
          },
          "koKR": {
            "present": true,
            "value": "이렇게 앙증맞은 녀석을 거대한 기계식 최첨단 고릴라 로봇 팔로 부숴 버리다니..."
          },
          "plPL": {
            "present": true,
            "value": "Ile żarników potrzeba, żeby wkręcić żarówkę?"
          },
          "ptBR": {
            "present": true,
            "value": "Eles são meio cabeça oca."
          },
          "ruRU": {
            "present": true,
            "value": "Светлая голова, хоть и робот!"
          },
          "thTH": {
            "present": true,
            "value": "พวกนี้ออกจะหัวใสนิดหน่อย"
          },
          "zhCN": {
            "present": true,
            "value": "小小灯泡，脑门锃亮；左摇右摆，晕头转向。"
          },
          "zhTW": {
            "present": true,
            "value": "頭會發光的代價是‧‧‧頭昏眼花。"
          }
        },
        "textContent": "\n\t\t\tEs ist keine große Leuchte, aber bei den anderen Mechs ist es sehr beliebt.\n\t\t\tThey're a little light-headed.\n\t\t\tEs superocurrente; cada dos por tres, se le ilumina la bombilla.\n\t\t\tSin dudas, una iluminada.\n\t\t\tC’est une tête d’ampoule.\n\t\t\tSono dei tipi un po' allampati!\n\t\t\tこいつの存在は、周囲を明るくしてくれる。\n\t\t\t이렇게 앙증맞은 녀석을 거대한 기계식 최첨단 고릴라 로봇 팔로 부숴 버리다니...\n\t\t\tIle żarników potrzeba, żeby wkręcić żarówkę?\n\t\t\tEles são meio cabeça oca.\n\t\t\tСветлая голова, хоть и робот!\n\t\t\tพวกนี้ออกจะหัวใสนิดหน่อย\n\t\t\t小小灯泡，脑门锃亮；左摇右摆，晕头转向。\n\t\t\t頭會發光的代價是‧‧‧頭昏眼花。\n\t\t"
      },
