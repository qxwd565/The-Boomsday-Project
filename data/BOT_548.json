      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Manno! Wenn er doch nur Todesröcheln hätte_..."
          },
          "enUS": {
            "present": true,
            "value": "Everything but the kitchen sink. Oh wait, there's one on his back."
          },
          "esES": {
            "present": true,
            "value": "Esto le da un nuevo significado al concepto de robot multiusos."
          },
          "esMX": {
            "present": true,
            "value": "Todo menos el lavabo de la cocina. Oh, un momento, tiene uno en la espalda."
          },
          "frFR": {
            "present": true,
            "value": "Il fait tout, sauf le café. Peut-être à la prochaine mise à jour !"
          },
          "itIT": {
            "present": true,
            "value": "Ha tutto tranne la macchina del caffè. Ah no, ne ha una sulla schiena."
          },
          "jaJP": {
            "present": true,
            "value": "この超万能ロボは、キッチンシンク以外のありとあらゆる機能を持ち…おおっと、背中に付いてた。"
          },
          "koKR": {
            "present": true,
            "value": "파이널 퓨전! 승인!"
          },
          "plPL": {
            "present": true,
            "value": "Jak coś jest do wszystkiego, to jest do niczego! Podobno."
          },
          "ptBR": {
            "present": true,
            "value": "Tem de tudo e mais um pouco."
          },
          "ruRU": {
            "present": true,
            "value": "Оснащен всем, кроме посудомойки... ан нет, вон она, под левой лопаткой."
          },
          "thTH": {
            "present": true,
            "value": "มีทุกอย่างยกเว้นอ่างล้างจาน\nเอ๊ะ เดี๋ยวนะ อ่างล้างจานอยู่ด้านหลัง"
          },
          "zhCN": {
            "present": true,
            "value": "设施完备，功能齐全，只缺一个水槽就能用了。等等，它背面有个水槽。"
          },
          "zhTW": {
            "present": true,
            "value": "整本家庭百科全書都在它電腦裡，而且背上連廚房水槽都有。"
          }
        },
        "textContent": "\n\t\t\tManno! Wenn er doch nur Todesröcheln hätte_...\n\t\t\tEverything but the kitchen sink. Oh wait, there's one on his back.\n\t\t\tEsto le da un nuevo significado al concepto de robot multiusos.\n\t\t\tTodo menos el lavabo de la cocina. Oh, un momento, tiene uno en la espalda.\n\t\t\tIl fait tout, sauf le café. Peut-être à la prochaine mise à jour !\n\t\t\tHa tutto tranne la macchina del caffè. Ah no, ne ha una sulla schiena.\n\t\t\tこの超万能ロボは、キッチンシンク以外のありとあらゆる機能を持ち…おおっと、背中に付いてた。\n\t\t\t파이널 퓨전! 승인!\n\t\t\tJak coś jest do wszystkiego, to jest do niczego! Podobno.\n\t\t\tTem de tudo e mais um pouco.\n\t\t\tОснащен всем, кроме посудомойки... ан нет, вон она, под левой лопаткой.\n\t\t\tมีทุกอย่างยกเว้นอ่างล้างจาน\nเอ๊ะ เดี๋ยวนะ อ่างล้างจานอยู่ด้านหลัง\n\t\t\t设施完备，功能齐全，只缺一个水槽就能用了。等等，它背面有个水槽。\n\t\t\t整本家庭百科全書都在它電腦裡，而且背上連廚房水槽都有。\n\t\t"
      },
