            "value": "<b>Magnétisme</b>, <b>Bouclier_divin</b>, <b>Provocation</b>,\n<b>Vol_de_vie</b>, <b>Ruée</b>"
          },
          "itIT": {
            "present": true,
            "value": "<b>Magnetismo</b>. <b>Scudo Divino</b>. <b>Provocazione</b>. <b>Furto Vitale</b>. <b>Assalto</b>."
          },
          "jaJP": {
            "present": true,
            "value": "<b>超電磁</b>\n<b>聖なる盾</b>、<b>挑発</b>\n<b>生命奪取</b>、<b>急襲</b>"
          },
          "koKR": {
            "present": true,
            "value": "<b>합체</b>, <b>천상의 보호막</b>\n<b>도발</b>, <b>생명력 흡수</b>, <b>속공</b>"
          },
          "plPL": {
            "present": true,
            "value": "<b>Magnetyzm</b>\n<b>Boska tarcza</b>\n<b>Prowokacja</b>\n<b>Kradzież_życia</b>\n<b>Zryw</b>"
          },
          "ptBR": {
            "present": true,
            "value": "<b>Magnético,</b>\n<b><b>Escudo Divino</b>, <b>Provocar</b>, Roubar Vida, Rapidez</b>"
          },
          "ruRU": {
            "present": true,
            "value": "<b>Магнетизм\nБожественный щит\nПровокация\nПохищение жизни\nНатиск</b>"
          },
          "thTH": {
            "present": true,
            "value": "<b>แม่เหล็ก</b>_<b><b>โล่ศักดิ์สิทธิ์</b> <b>ยั่วยุ</b>_สูบชีวิต_จู่โจม</b>"
          },
          "zhCN": {
            "present": true,
            "value": "<b>磁力，圣盾，嘲讽，吸血，突袭</b>"
          },
          "zhTW": {
            "present": true,
            "value": "<b>合體</b>\n<b>聖盾術</b>、<b>嘲諷</b>\n<b>生命竊取</b>、<b>衝刺</b>"
          }
        },
        "textContent": "\n\t\t<b>Magnetisch</b>, <b>Gottesschild</b>, <b>Spott</b>, <b>Lebensentzug</b>, <b>Eifer</b>\n\t\t<b>Magnetic</b>\n<b><b>Divine Shield</b>, <b>Taunt</b>, Lifesteal, Rush</b>\n\t\t<b>Magnetismo</b>\n<b><b>Escudo divino</b>\n<b>Provocar</b>\nRobo de vida\nEmbestir</b>\n\t\t<b>Magnetismo</b>\n<b><b>Escudo divino</b>, <b>Provocación</b>, Robavida,_Acometida</b>\n\t\t<b>Magnétisme</b>, <b>Bouclier_divin</b>, <b>Provocation</b>,\n<b>Vol_de_vie</b>, <b>Ruée</b>\n\t\t<b>Magnetismo</b>. <b>Scudo Divino</b>. <b>Provocazione</b>. <b>Furto Vitale</b>. <b>Assalto</b>.\n\t\t<b>超電磁</b>\n<b>聖なる盾</b>、<b>挑発</b>\n<b>生命奪取</b>、<b>急襲</b>\n\t\t<b>합체</b>, <b>천상의 보호막</b>\n<b>도발</b>, <b>생명력 흡수</b>, <b>속공</b>\n\t\t<b>Magnetyzm</b>\n<b>Boska tarcza</b>\n<b>Prowokacja</b>\n<b>Kradzież_życia</b>\n<b>Zryw</b>\n\t\t<b>Magnético,</b>\n<b><b>Escudo Divino</b>, <b>Provocar</b>, Roubar Vida, Rapidez</b>\n\t\t<b>Магнетизм\nБожественный щит\nПровокация\nПохищение жизни\nНатиск</b>\n\t\t<b>แม่เหล็ก</b>_<b><b>โล่ศักดิ์สิทธิ์</b> <b>ยั่วยุ</b>_สูบชีวิต_จู่โจม</b>\n\t\t<b>磁力，圣盾，嘲讽，吸血，突袭</b>\n\t\t<b>合體</b>\n<b>聖盾術</b>、<b>嘲諷</b>\n<b>生命竊取</b>、<b>衝刺</b>\n\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Manno! Wenn er doch nur Todesröcheln hätte_..."
          },
          "enUS": {
            "present": true,
            "value": "Everything but the kitchen sink. Oh wait, there's one on his back."
          },
          "esES": {
            "present": true,
            "value": "Esto le da un nuevo significado al concepto de robot multiusos."
          },
          "esMX": {
            "present": true,
            "value": "Todo menos el lavabo de la cocina. Oh, un momento, tiene uno en la espalda."
          },
          "frFR": {
            "present": true,
            "value": "Il fait tout, sauf le café. Peut-être à la prochaine mise à jour !"
          },
          "itIT": {
            "present": true,
            "value": "Ha tutto tranne la macchina del caffè. Ah no, ne ha una sulla schiena."
          },
          "jaJP": {
            "present": true,
            "value": "この超万能ロボは、キッチンシンク以外のありとあらゆる機能を持ち…おおっと、背中に付いてた。"
          },
          "koKR": {
            "present": true,
            "value": "파이널 퓨전! 승인!"
          },
          "plPL": {
            "present": true,
            "value": "Jak coś jest do wszystkiego, to jest do niczego! Podobno."
          },
          "ptBR": {
            "present": true,
            "value": "Tem de tudo e mais um pouco."
          },
          "ruRU": {
            "present": true,
            "value": "Оснащен всем, кроме посудомойки... ан нет, вон она, под левой лопаткой."
          },
          "thTH": {
            "present": true,
            "value": "มีทุกอย่างยกเว้นอ่างล้างจาน\nเอ๊ะ เดี๋ยวนะ อ่างล้างจานอยู่ด้านหลัง"
          },
          "zhCN": {
            "present": true,
            "value": "设施完备，功能齐全，只缺一个水槽就能用了。等等，它背面有个水槽。"
          },
          "zhTW": {
            "present": true,
            "value": "整本家庭百科全書都在它電腦裡，而且背上連廚房水槽都有。"
          }
        },
        "textContent": "\n\t\tManno! Wenn er doch nur Todesröcheln hätte_...\n\t\tEverything but the kitchen sink. Oh wait, there's one on his back.\n\t\tEsto le da un nuevo significado al concepto de robot multiusos.\n\t\tTodo menos el lavabo de la cocina. Oh, un momento, tiene uno en la espalda.\n\t\tIl fait tout, sauf le café. Peut-être à la prochaine mise à jour !\n\t\tHa tutto tranne la macchina del caffè. Ah no, ne ha una sulla schiena.\n\t\tこの超万能ロボは、キッチンシンク以外のありとあらゆる機能を持ち…おおっと、背中に付いてた。\n\t\t파이널 퓨전! 승인!\n\t\tJak coś jest do wszystkiego, to jest do niczego! Podobno.\n\t\tTem de tudo e mais um pouco.\n\t\tОснащен всем, кроме посудомойки... ан нет, вон она, под левой лопаткой.\n\t\tมีทุกอย่างยกเว้นอ่างล้างจาน\nเอ๊ะ เดี๋ยวนะ อ่างล้างจานอยู่ด้านหลัง\n\t\t设施完备，功能齐全，只缺一个水槽就能用了。等等，它背面有个水槽。\n\t\t整本家庭百科全書都在它電腦裡，而且背上連廚房水槽都有。\n\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "L. Lullabi & K. Turovec"
      }
    }
