          "jaJP": {
            "present": true,
            "value": "ベストセラー「人をロボ化す」の著者。"
          },
          "koKR": {
            "present": true,
            "value": "불티나게 팔리고 있는 책인 \"내가 완벽하게 조종할 수 있는 친구 만들기\"의 저자입니다."
          },
