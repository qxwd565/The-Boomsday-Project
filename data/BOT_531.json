    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "Celestial Emissary"
          },
          "koKR": {
            "present": true,
            "value": "별빛 사절"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tGalaktischer Gesandter\n\t\t\tCelestial Emissary\n\t\t\tEmisario celestial\n\t\t\tEmisario celestial\n\t\t\tÉmissaire céleste\n\t\t\tEmissario Celeste\n\t\t\t星界からの使者\n\t\t\t별빛 사절\n\t\t\tGwiezdny wysłannik\n\t\t\tEmissário Celestial\n\t\t\tПосланник небес\n\t\t\tทูตแห่งดวงดาว\n\t\t\t星界密使\n\t\t\t星界特使\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Your next spell_this turn has <b>Spell_Damage +2</b>."
          },
          "koKR": {
            "present": true,
            "value": "<b>전투의 함성:</b> 이번 턴의 내 다음 주문이 <b>주문 공격력 +2</b>를 얻습니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Kampfschrei:</b> Euer nächster Zauber in diesem Zug hat <b>Zauberschaden +2</b>.\n\t\t\t<b>Battlecry:</b> Your next spell_this turn has <b>Spell_Damage +2</b>.\n\t\t\t[x]<b>Grito de batalla:</b> Tu próximo\nhechizo en este turno\ntiene <b>+2 p. de daño\ncon hechizos</b>.\n\t\t\t<b>Grito de batalla:</b> tu próximo hechizo este turno tiene <b>Daño de hechizo +2</b>.\n\t\t\t<b>Cri de guerre_:</b> votre prochain sort pendant ce tour a <b>+2 aux dégâts des sorts</b>.\n\t\t\t[x]<b>Grido di Battaglia:</b>\nla prossima Magia che\nlanci in questo turno\nha <b>+2 Danni Magici</b>.\n\t\t\t[x]<b>雄叫び:</b>\nこのターン、自分が\n次に使用する呪文は\n____<b>呪文ダメージ+2</b>を得る。\n\t\t\t<b>전투의 함성:</b> 이번 턴의 내 다음 주문이 <b>주문 공격력 +2</b>를 얻습니다.\n\t\t\t<b>Okrzyk bojowy:</b>\nTwoje następne zaklęcie w_tej turze ma <b>Obrażenia_zaklęć_+2</b>.\n\t\t\t<b>Grito de Guerra:</b> \nSeu próximo feitiço neste turno tem <b>+2 de Dano Mágico</b>.\n\t\t\t[x]<b>Боевой клич:</b> ваше\nследующее заклинание\nна этом ходу получает\n________<b>урон от заклинаний +2</b>.___\n\t\t\t<b>คำรามสู้ศึก:</b> เวทมนตร์[b]ใบถัดไปที่คุณร่ายในเทิร์นนี้มี <b>ความเสียหายเวท +2</b>\n\t\t\t<b>战吼：</b>在本回合中，你的下一个法术将获得<b>法术伤害+2</b>。\n\t\t\t<b>戰吼：</b>本回合\n你的下一個法術獲得<b>法術傷害+2</b>\n\t\t"
      }
    },
