      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Vor ihr ist kein Geheimnis sicher."
          },
          "enUS": {
            "present": true,
            "value": "The original clever girl."
          },
          "esES": {
            "present": true,
            "value": "Qué lista eres."
          },
          "esMX": {
            "present": true,
            "value": "Seguro que también sabe abrir la puerta."
          },
          "frFR": {
            "present": true,
            "value": "« Je ne suis pas un numéro ! »"
          },
          "itIT": {
            "present": true,
            "value": "Essere arrivati al numero 9 non è mai un buon segno."
          },
          "jaJP": {
            "present": true,
            "value": "こいつこそ、元祖「お利口さん」だったんだ。"
          },
          "koKR": {
            "present": true,
            "value": "바로 그 영리한 녀석입니다."
          },
          "plPL": {
            "present": true,
            "value": "Możliwe, że w laboratorium przydałyby się jakieś obostrzenia."
          },
          "ptBR": {
            "present": true,
            "value": "Antes ela morava em um parque de diversões jurássico."
          },
          "ruRU": {
            "present": true,
            "value": "В прошлом_– хорошая девочка."
          },
          "thTH": {
            "present": true,
            "value": "เวโลซีแร็ปเปอร์ตัวแรกของโลก โจ้ว โจ้ว"
          },
          "zhCN": {
            "present": true,
            "value": "她是最聪明的那一只。"
          },
          "zhTW": {
            "present": true,
            "value": "她就是那個聰明的傢伙。"
          }
        },
        "textContent": "\n\t\t\tVor ihr ist kein Geheimnis sicher.\n\t\t\tThe original clever girl.\n\t\t\tQué lista eres.\n\t\t\tSeguro que también sabe abrir la puerta.\n\t\t\t« Je ne suis pas un numéro ! »\n\t\t\tEssere arrivati al numero 9 non è mai un buon segno.\n\t\t\tこいつこそ、元祖「お利口さん」だったんだ。\n\t\t\t바로 그 영리한 녀석입니다.\n\t\t\tMożliwe, że w laboratorium przydałyby się jakieś obostrzenia.\n\t\t\tAntes ela morava em um parque de diversões jurássico.\n\t\t\tВ прошлом_– хорошая девочка.\n\t\t\tเวโลซีแร็ปเปอร์ตัวแรกของโลก โจ้ว โจ้ว\n\t\t\t她是最聪明的那一只。\n\t\t\t她就是那個聰明的傢伙。\n\t\t"
      },
