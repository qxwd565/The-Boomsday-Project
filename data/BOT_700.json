            "value": "[x]<b>Magnetismo</b>\n<b>Eco</b>\n<b>Último aliento:</b> Invoca\ndos microbots 1/1."
          },
          "esMX": {
            "present": true,
            "value": "<b>Magnetismo</b>, <b>Eco</b>\n<b>Estertor:</b> invoca dos Microbots 1/1."
          },
          "frFR": {
            "present": true,
            "value": "<b>Magnétisme</b>, <b>Écho</b>\n<b>Râle d’agonie :</b> invoque deux_microbots_1/1."
          },
          "itIT": {
            "present": true,
            "value": "<b>Magnetismo</b>. <b>Eco</b>. <b>Rantolo di Morte:</b> evoca due Microbot 1/1."
          },
          "jaJP": {
            "present": true,
            "value": "<b>超電磁</b>、<b>木霊</b>\n<b>断末魔:</b>\n1/1の「マイクロロボ」を2体召喚する。"
          },
          "koKR": {
            "present": true,
            "value": "<b>합체</b>, <b>잔상</b> <b>죽음의_메아리:</b>\n1/1 초소형 로봇을 둘 소환합니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Magnetyzm</b>, <b>Echo</b>\n<b>Agonia:</b> Przyzwij dwa Mikroboty 1/1."
          },
          "ptBR": {
            "present": true,
            "value": "<b>Magnético</b>, <b>Eco</b>\n<b>Último Suspiro:</b>\nEvoque dois\nMicrorrobôs 1/1."
          },
          "ruRU": {
            "present": true,
            "value": "<b>Магнетизм. Эхо.\nПредсмертный хрип:</b> призывает двух микроботов 1/1."
          },
          "thTH": {
            "present": true,
            "value": "<b>แม่เหล็ก</b> <b>เสียงสะท้อน</b> <b>เสียงสุดท้าย:</b> เรียก[b]ไมโครบอท_1/1 สองตัว"
          },
          "zhCN": {
            "present": true,
            "value": "<b>磁力，回响，亡语：</b>召唤两个1/1的微型机器人。"
          },
          "zhTW": {
            "present": true,
            "value": "[x]<b>合體</b>、<b>回音</b>\n<b>死亡之聲：</b>召喚兩個\n1/1微型機器人"
          }
        },
        "textContent": "\n\t\t<b>Magnetisch</b>, <b>Echo</b>. <b>Todesröcheln:</b> Ruft 2 Mikrobots (1/1) herbei.\n\t\t<b>Magnetic</b>, <b>Echo</b>\n<b>Deathrattle:</b> Summon two 1/1 Microbots.\n\t\t[x]<b>Magnetismo</b>\n<b>Eco</b>\n<b>Último aliento:</b> Invoca\ndos microbots 1/1.\n\t\t<b>Magnetismo</b>, <b>Eco</b>\n<b>Estertor:</b> invoca dos Microbots 1/1.\n\t\t<b>Magnétisme</b>, <b>Écho</b>\n<b>Râle d’agonie :</b> invoque deux_microbots_1/1.\n\t\t<b>Magnetismo</b>. <b>Eco</b>. <b>Rantolo di Morte:</b> evoca due Microbot 1/1.\n\t\t<b>超電磁</b>、<b>木霊</b>\n<b>断末魔:</b>\n1/1の「マイクロロボ」を2体召喚する。\n\t\t<b>합체</b>, <b>잔상</b> <b>죽음의_메아리:</b>\n1/1 초소형 로봇을 둘 소환합니다.\n\t\t<b>Magnetyzm</b>, <b>Echo</b>\n<b>Agonia:</b> Przyzwij dwa Mikroboty 1/1.\n\t\t<b>Magnético</b>, <b>Eco</b>\n<b>Último Suspiro:</b>\nEvoque dois\nMicrorrobôs 1/1.\n\t\t<b>Магнетизм. Эхо.\nПредсмертный хрип:</b> призывает двух микроботов 1/1.\n\t\t<b>แม่เหล็ก</b> <b>เสียงสะท้อน</b> <b>เสียงสุดท้าย:</b> เรียก[b]ไมโครบอท_1/1 สองตัว\n\t\t<b>磁力，回响，亡语：</b>召唤两个1/1的微型机器人。\n\t\t[x]<b>合體</b>、<b>回音</b>\n<b>死亡之聲：</b>召喚兩個\n1/1微型機器人\n\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Wenn man ihn angreift, wird er immer gleich so schnippisch."
          },
          "enUS": {
            "present": true,
            "value": "\"It's gonna be snip this, snap that. Bada-snip, bada-snap!\""
          },
          "esES": {
            "present": true,
            "value": "Habrá que atenazar allí y atenazar allá. ¡Atenazar así y atenazar asá!"
          },
          "esMX": {
            "present": true,
            "value": "\"¡Clic, clac, clic, clic, clac!\""
          },
          "frFR": {
            "present": true,
            "value": "« Il va faire tchic par ci, tchac par là. Tchic, tchac, tchic, tchac, tchic, aïe aïe aïe ! »"
          },
          "itIT": {
            "present": true,
            "value": "\"Ci sarà da lavorare di taglio. E patatagli e patataglie!\""
          },
          "jaJP": {
            "present": true,
            "value": "ゴブリン式全自動散髪機を改修して多機能化に成功したが、散髪性能は据え置きである。"
          },
          "koKR": {
            "present": true,
            "value": "뭐든 4ㅓ걱4ㅓ걱 갈라버립니다."
          },
          "plPL": {
            "present": true,
            "value": "„Ciachu-ciachu, szastu-prastu, nie mam rączek jedenastu!”."
          },
          "ptBR": {
            "present": true,
            "value": "\"Vai ser um rapa aqui, tasca ali. Pega-tasca, rouba-rapa!\""
          },
          "ruRU": {
            "present": true,
            "value": "Гроза центральных линий."
          },
          "thTH": {
            "present": true,
            "value": "\"ตัดเลยตัดเลย ชับชับชับ ตัดให้ขาดเลย ชับชับชับ\""
          },
          "zhCN": {
            "present": true,
            "value": "“咔嚓这个，咔嚓那个；横着咔嚓，竖着咔嚓！”"
          },
          "zhTW": {
            "present": true,
            "value": "喀擦這個，喀擦那個！這樣喀擦，那樣喀擦！"
          }
        },
        "textContent": "\n\t\tWenn man ihn angreift, wird er immer gleich so schnippisch.\n\t\t\"It's gonna be snip this, snap that. Bada-snip, bada-snap!\"\n\t\tHabrá que atenazar allí y atenazar allá. ¡Atenazar así y atenazar asá!\n\t\t\"¡Clic, clac, clic, clic, clac!\"\n\t\t« Il va faire tchic par ci, tchac par là. Tchic, tchac, tchic, tchac, tchic, aïe aïe aïe ! »\n\t\t\"Ci sarà da lavorare di taglio. E patatagli e patataglie!\"\n\t\tゴブリン式全自動散髪機を改修して多機能化に成功したが、散髪性能は据え置きである。\n\t\t뭐든 4ㅓ걱4ㅓ걱 갈라버립니다.\n\t\t„Ciachu-ciachu, szastu-prastu, nie mam rączek jedenastu!”.\n\t\t\"Vai ser um rapa aqui, tasca ali. Pega-tasca, rouba-rapa!\"\n\t\tГроза центральных линий.\n\t\t\"ตัดเลยตัดเลย ชับชับชับ ตัดให้ขาดเลย ชับชับชับ\"\n\t\t“咔嚓这个，咔嚓那个；横着咔嚓，竖着咔嚓！”\n\t\t喀擦這個，喀擦那個！這樣喀擦，那樣喀擦！\n\t"
      },
