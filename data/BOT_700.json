      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Wenn man ihn angreift, wird er immer gleich so schnippisch."
          },
          "enUS": {
            "present": true,
            "value": "\"It's gonna be snip this, snap that. Bada-snip, bada-snap!\""
          },
          "esES": {
            "present": true,
            "value": "Habrá que atenazar allí y atenazar allá. ¡Atenazar así y atenazar asá!"
          },
          "esMX": {
            "present": true,
            "value": "\"¡Clic, clac, clic, clic, clac!\""
          },
          "frFR": {
            "present": true,
            "value": "« Il va faire tchic par ci, tchac par là. Tchic, tchac, tchic, tchac, tchic, aïe aïe aïe ! »"
          },
          "itIT": {
            "present": true,
            "value": "\"Ci sarà da lavorare di taglio. E patatagli e patataglie!\""
          },
          "jaJP": {
            "present": true,
            "value": "ゴブリン式全自動散髪機を改修して多機能化に成功したが、散髪性能は据え置きである。"
          },
          "koKR": {
            "present": true,
            "value": "뭐든 4ㅓ걱4ㅓ걱 갈라버립니다."
          },
          "plPL": {
            "present": true,
            "value": "„Ciachu-ciachu, szastu-prastu, nie mam rączek jedenastu!”."
          },
          "ptBR": {
            "present": true,
            "value": "\"Vai ser um rapa aqui, tasca ali. Pega-tasca, rouba-rapa!\""
          },
          "ruRU": {
            "present": true,
            "value": "Гроза центральных линий."
          },
          "thTH": {
            "present": true,
            "value": "ตัดเลยตัดเลย ชับชับชับ ตัดให้ขาดเลย ชับชับชับ"
          },
          "zhCN": {
            "present": true,
            "value": "“咔嚓这个，咔嚓那个；横着咔嚓，竖着咔嚓！”"
          },
          "zhTW": {
            "present": true,
            "value": "喀擦這個，喀擦那個！這樣喀擦，那樣喀擦！"
          }
        },
        "textContent": "\n\t\t\tWenn man ihn angreift, wird er immer gleich so schnippisch.\n\t\t\t\"It's gonna be snip this, snap that. Bada-snip, bada-snap!\"\n\t\t\tHabrá que atenazar allí y atenazar allá. ¡Atenazar así y atenazar asá!\n\t\t\t\"¡Clic, clac, clic, clic, clac!\"\n\t\t\t« Il va faire tchic par ci, tchac par là. Tchic, tchac, tchic, tchac, tchic, aïe aïe aïe ! »\n\t\t\t\"Ci sarà da lavorare di taglio. E patatagli e patataglie!\"\n\t\t\tゴブリン式全自動散髪機を改修して多機能化に成功したが、散髪性能は据え置きである。\n\t\t\t뭐든 4ㅓ걱4ㅓ걱 갈라버립니다.\n\t\t\t„Ciachu-ciachu, szastu-prastu, nie mam rączek jedenastu!”.\n\t\t\t\"Vai ser um rapa aqui, tasca ali. Pega-tasca, rouba-rapa!\"\n\t\t\tГроза центральных линий.\n\t\t\tตัดเลยตัดเลย ชับชับชับ ตัดให้ขาดเลย ชับชับชับ\n\t\t\t“咔嚓这个，咔嚓那个；横着咔嚓，竖着咔嚓！”\n\t\t\t喀擦這個，喀擦那個！這樣喀擦，那樣喀擦！\n\t\t"
      },
