      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "EMP, mit freundlichen Grüßen. Die Mechs liegen mir zu Füßen, denn ich stehe drauf."
          },
          "enUS": {
            "present": true,
            "value": "\"I said this looks like a job for me\nSo everybody just follow me\n'Cause we need a little E.M.P.\n'Cause it feels so mechy without me…\""
          },
          "esES": {
            "present": true,
            "value": "No le tiembla el pulso electromagnético."
          },
          "esMX": {
            "present": true,
            "value": "\"Más inteligente que la 99, más fuerte que Lara…\" Todos me adulan cuando necesitan mis servicios..."
          },
          "frFR": {
            "present": true,
            "value": "Son appareil lui permet d’introduire des bugs dans la matrice et d’arrêter les Méca."
          },
          "itIT": {
            "present": true,
            "value": "Il peggior incubo di ogni reparto IT."
          },
          "jaJP": {
            "present": true,
            "value": "日が暮れるように\n弱くなってゆくよ\n消えかかる　メカのパルス\nI'm here"
          },
          "koKR": {
            "present": true,
            "value": "¿Quién es Sombra?"
          },
          "plPL": {
            "present": true,
            "value": "Mechom aż wygina się metal ze strachu, gdy tylko ktoś o niej wspomni."
          },
          "ptBR": {
            "present": true,
            "value": "\"Diga, se te deixei faltar robô, se o meu pulso é sem valor, se não fui agente pra você...\""
          },
          "ruRU": {
            "present": true,
            "value": "О, как устала я возиться вечно с теми,\nКто механизмы «номинирует на ЭМИ»..."
          },
          "thTH": {
            "present": true,
            "value": "มองทางโน้นไม่มี E\nมองทางนี้ไม่เจอ M\nมองทางไหนถึงเจอ P"
          },
          "zhCN": {
            "present": true,
            "value": "我说这事非得我出马不行\n所有人都给我过来这里听\n因为我们需要一点E.M.P.\n因为它们只能由我来搞定"
          },
          "zhTW": {
            "present": true,
            "value": "看來這件事非我來不行，\n所有人都給我過來這裡。\n我們會需要一點E.M.P.，\n只有我可以解決這些機器…"
          }
        },
        "textContent": "\n\t\t\tEMP, mit freundlichen Grüßen. Die Mechs liegen mir zu Füßen, denn ich stehe drauf.\n\t\t\t\"I said this looks like a job for me\nSo everybody just follow me\n'Cause we need a little E.M.P.\n'Cause it feels so mechy without me…\"\n\t\t\tNo le tiembla el pulso electromagnético.\n\t\t\t\"Más inteligente que la 99, más fuerte que Lara…\" Todos me adulan cuando necesitan mis servicios...\n\t\t\tSon appareil lui permet d’introduire des bugs dans la matrice et d’arrêter les Méca.\n\t\t\tIl peggior incubo di ogni reparto IT.\n\t\t\t日が暮れるように\n弱くなってゆくよ\n消えかかる　メカのパルス\nI'm here\n\t\t\t¿Quién es Sombra?\n\t\t\tMechom aż wygina się metal ze strachu, gdy tylko ktoś o niej wspomni.\n\t\t\t\"Diga, se te deixei faltar robô, se o meu pulso é sem valor, se não fui agente pra você...\"\n\t\t\tО, как устала я возиться вечно с теми,\nКто механизмы «номинирует на ЭМИ»...\n\t\t\tมองทางโน้นไม่มี E\nมองทางนี้ไม่เจอ M\nมองทางไหนถึงเจอ P\n\t\t\t我说这事非得我出马不行\n所有人都给我过来这里听\n因为我们需要一点E.M.P.\n因为它们只能由我来搞定\n\t\t\t看來這件事非我來不行，\n所有人都給我過來這裡。\n我們會需要一點E.M.P.，\n只有我可以解決這些機器…\n\t\t"
      },
