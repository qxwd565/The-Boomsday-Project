    "launchStrings": {
      "185": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "E.M.P. Operative"
          },
          "koKR": {
            "present": true,
            "value": "E.M.P. 비밀요원"
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tEMP-Expertin\n\t\t\tE.M.P. Operative\n\t\t\tOperativa de PEM\n\t\t\tAgente de P.E.M.\n\t\t\tAgent émetteur d’I.E.M.\n\t\t\tAgente Elettromagnetica\n\t\t\t電磁パルス工作員\n\t\t\tE.M.P. 비밀요원\n\t\t\tElektromagnetyczna agentka\n\t\t\tAgente de P.E.M.\n\t\t\tАгент ЭМИ\n\t\t\tหน่วยปฏิบัติการ E.M.P.\n\t\t\t电磁脉冲特工\n\t\t\tE.M.P.特務\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Destroy a Mech."
          },
          "koKR": {
            "present": true,
            "value": "<b>전투의 함성:</b>\n기계를 하나 처치합니다."
          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Kampfschrei:</b> Vernichtet einen Mech.\n\t\t\t<b>Battlecry:</b> Destroy a Mech.\n\t\t\t<b>Grito de batalla:</b> Destruye un robot.\n\t\t\t<b>Grito de batalla:</b> destruye un Meca.\n\t\t\t<b>Cri de guerre_:</b>\ndétruit un Méca.\n\t\t\t<b>Grido di Battaglia:</b> distrugge un Robot.\n\t\t\t[x]<b>雄叫び:</b>\n__メカ1体を破壊する。\n\t\t\t<b>전투의 함성:</b>\n기계를 하나 처치합니다.\n\t\t\t<b>Okrzyk bojowy:</b> Zniszcz Mecha.\n\t\t\t<b>Grito de Guerra:</b> Destrua um Mecanoide.\n\t\t\t<b>Боевой клич:</b> уничтожает выбранный механизм.\n\t\t\t<b>คำรามสู้ศึก:</b> ทำลาย[b]มินเนี่ยนเครื่องจักรหนึ่งตัว\n\t\t\t<b>战吼：</b>\n消灭一个机械。\n\t\t\t<b>戰吼：</b>摧毀一個機械\n\t\t"
      }
    },
