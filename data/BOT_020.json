      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Auch für Bots gilt Helmpflicht, besonders bei raketenbetriebenen Skateboards."
          },
          "enUS": {
            "present": true,
            "value": "\"See you later bot\"\n- Jaina"
          },
          "esES": {
            "present": true,
            "value": "¿Para qué entrenar duro cuando puedes pegar dos cohetes a tu patín e ir como una bala?"
          },
          "esMX": {
            "present": true,
            "value": "\"El verdadero arte del patinaje solo se aprecia en el hielo\". - Jaina"
          },
          "frFR": {
            "present": true,
            "value": "« Salut. Ça farte ? »"
          },
          "itIT": {
            "present": true,
            "value": "\"Corri ragazzo laggiù!\""
          },
          "jaJP": {
            "present": true,
            "value": "シャキーン　取れたパーツとバリヤー\n凹凸を合わせ　すんげェ\nスケボー　スケボー　スケボー　スケボー"
          },
          "koKR": {
            "present": true,
            "value": "그 스케이트 이름, 혹시 탈룰라는 아니겠죠?"
          },
          "plPL": {
            "present": true,
            "value": "Został zdyskwalifikowany z lokalnych zawodów deskorolkowych za używanie niedozwolonego wspomagania."
          },
          "ptBR": {
            "present": true,
            "value": "\"Até mais, robô.\" - Jaina"
          },
          "ruRU": {
            "present": true,
            "value": "Гораздо менее агрессивная модель, чем хейтербот."
          },
          "thTH": {
            "present": true,
            "value": "เป็นทั้งเด็กบอร์ด[b]และเด็กบอท"
          },
          "zhCN": {
            "present": true,
            "value": "我的滑板车时尚时尚最时尚。"
          },
          "zhTW": {
            "present": true,
            "value": "「他是個滑板男孩，她說掰掰囉，男孩。」"
          }
        },
        "textContent": "\n\t\t\tAuch für Bots gilt Helmpflicht, besonders bei raketenbetriebenen Skateboards.\n\t\t\t\"See you later bot\"\n- Jaina\n\t\t\t¿Para qué entrenar duro cuando puedes pegar dos cohetes a tu patín e ir como una bala?\n\t\t\t\"El verdadero arte del patinaje solo se aprecia en el hielo\". - Jaina\n\t\t\t« Salut. Ça farte ? »\n\t\t\t\"Corri ragazzo laggiù!\"\n\t\t\tシャキーン　取れたパーツとバリヤー\n凹凸を合わせ　すんげェ\nスケボー　スケボー　スケボー　スケボー\n\t\t\t그 스케이트 이름, 혹시 탈룰라는 아니겠죠?\n\t\t\tZostał zdyskwalifikowany z lokalnych zawodów deskorolkowych za używanie niedozwolonego wspomagania.\n\t\t\t\"Até mais, robô.\" - Jaina\n\t\t\tГораздо менее агрессивная модель, чем хейтербот.\n\t\t\tเป็นทั้งเด็กบอร์ด[b]และเด็กบอท\n\t\t\t我的滑板车时尚时尚最时尚。\n\t\t\t「他是個滑板男孩，她說掰掰囉，男孩。」\n\t\t"
      },
      "342": {
        "present": true,
