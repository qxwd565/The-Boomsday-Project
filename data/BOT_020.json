          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\t<b>Magnetisch</b>, <b>Eifer</b>\n\t\t\t<b>Magnetic</b>\n<b>Rush</b>\n\t\t\t<b>Magnetismo</b>\n<b>Embestir</b>\n\t\t\t<b>Magnetismo</b>\n<b>Acometida</b>\n\t\t\t<b>Magnétisme</b>\n<b>Ruée</b>\n\t\t\t[x]<b>Magnetismo</b>.\n<b>Assalto</b>.\n\t\t\t<b>超電磁</b>\n<b>急襲</b>\n\t\t\t<b>합체</b>\n<b>속공</b>\n\t\t\t<b>Magnetyzm</b>\n<b>Zryw</b>\n\t\t\t<b>Magnético</b>\n<b>Rapidez</b>\n\t\t\t<b>Магнетизм</b>\n<b>Натиск</b>\n\t\t\t<b>แม่เหล็ก</b>\n<b>จู่โจม</b>\n\t\t\t<b>磁力</b>\n<b>突袭</b>\n\t\t\t<b>合體</b>\n<b>衝刺</b>\n\t\t"
      }
