          }
        },
        "valueAttributePresent": false,
        "valueAttribute": null,
        "textContent": "\n\t\t\tFedergetriebene Rakete\n\t\t\tSpring Rocket\n\t\t\tCohete de muelles\n\t\t\tCohete resorte\n\t\t\tFusée à ressort\n\t\t\tMissile a Molla\n\t\t\tスプリング・ロケット\n\t\t\t용수철 로켓\n\t\t\tRakieta sprężynowa\n\t\t\tFogueteiro Articulado\n\t\t\tПружинная ракета\n\t\t\tจรวดสปริง\n\t\t\t弹簧火箭犬\n\t\t\t彈簧火箭犬\n\t\t"
      },
      "184": {
        "present": true,
        "locales": {
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Deal 2 damage."
          },
          "koKR": {
