      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Das Neueste in der Raketentechnologie: der Antrieb per Spannfeder!"
          },
          "enUS": {
            "present": true,
            "value": "Proper grammar would be \"sprung rocket.\""
          },
          "esES": {
            "present": true,
            "value": "Da gusto verlo bajar las escaleras."
          },
          "esMX": {
            "present": true,
            "value": "Lo correcto sería \"cohete con resorte\"."
          },
          "frFR": {
            "present": true,
            "value": "Il en a eu assez de ne descendre que les escaliers. Maintenant, il descend aussi ses adversaires !"
          },
          "itIT": {
            "present": true,
            "value": "Attenzione: caricare sempre in presenza di un adulto."
          },
          "jaJP": {
            "present": true,
            "value": "階段の下にいるヤツを爆殺したい時に便利だが、とにかくよく絡まることで有名。"
          },
          "koKR": {
            "present": true,
            "value": "잠깐, 로켓 용수철이 더 맞는 말일까요?"
          },
          "plPL": {
            "present": true,
            "value": "Fajna rzecz, ale czy ma jakieś praktyczne zastosowanie?"
          },
          "ptBR": {
            "present": true,
            "value": "Não confundir com \"fogueteiro aloprado\"."
          },
          "ruRU": {
            "present": true,
            "value": "На самом деле проект назывался «Ужиная ракета», но какие-то шутники накорябали в документации лишние буквы."
          },
          "thTH": {
            "present": true,
            "value": "ยืดได้ หดได้ บางทีก็แข็ง บางทีก็อ่อน นี่เรากำลังพูดถึงสปริงอยู่นะ"
          },
          "zhCN": {
            "present": true,
            "value": "自从有了火箭做推进器，弹簧就成为了过去式。"
          },
          "zhTW": {
            "present": true,
            "value": "雖然彈簧都鬆了，但火箭又讓他重振雄風。"
          }
        },
        "textContent": "\n\t\t\tDas Neueste in der Raketentechnologie: der Antrieb per Spannfeder!\n\t\t\tProper grammar would be \"sprung rocket.\"\n\t\t\tDa gusto verlo bajar las escaleras.\n\t\t\tLo correcto sería \"cohete con resorte\".\n\t\t\tIl en a eu assez de ne descendre que les escaliers. Maintenant, il descend aussi ses adversaires !\n\t\t\tAttenzione: caricare sempre in presenza di un adulto.\n\t\t\t階段の下にいるヤツを爆殺したい時に便利だが、とにかくよく絡まることで有名。\n\t\t\t잠깐, 로켓 용수철이 더 맞는 말일까요?\n\t\t\tFajna rzecz, ale czy ma jakieś praktyczne zastosowanie?\n\t\t\tNão confundir com \"fogueteiro aloprado\".\n\t\t\tНа самом деле проект назывался «Ужиная ракета», но какие-то шутники накорябали в документации лишние буквы.\n\t\t\tยืดได้ หดได้ บางทีก็แข็ง บางทีก็อ่อน นี่เรากำลังพูดถึงสปริงอยู่นะ\n\t\t\t自从有了火箭做推进器，弹簧就成为了过去式。\n\t\t\t雖然彈簧都鬆了，但火箭又讓他重振雄風。\n\t\t"
      },
